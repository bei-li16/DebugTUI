# 0.9.0: For Chip / Debug cores selection use version=3 plus [debug].
# See profiles/tha6-project.toml.example and profiles/tha6-environment.toml.example.
# This default keeps the legacy single-core configuration.
version = 2
watch = []
[gdb]
executable = "gdb"
[program]
elf = "./build/app.elf"
source_root = "."

# Setup: Source remap -> choose an ELF directory that corresponds to Source root.
# No extra tool: metadata-only scan uses your configured GDB, without connecting.
# [source_remap]
# enabled = true
# from = "/ci/build/firmware"
# Optional CMSIS-SVD, resolved relative to this project configuration.
# svd = "./.vscode/svd/STM32F429.svd"
[target]
mode = "remote"
endpoint = "127.0.0.1:3333"
[session]
on_exit = "detach"

# Optional shell commands, run in program.source_root (not the TUI install folder).
# [tasks]
# build = 'build.bat'
# download = 'flash.bat'
# timeout_ms = 300000
# Blank download uses the environment's GDB actions.download, when defined.

# To use a tools environment instead, remove the [gdb] section above and add:
# [tools]
# profile = "builtin:arm-openocd"
# probe = "cmsis-dap"
# For the bundled common profile, also set version = 3 at the top and select:
# [debug]
# chip = "stm32f429"
# cores = [0]
# Or run debugtui in the firmware directory to create the minimal bundled-tools project.

# Optional UI preferences (saved by :appearance and each value's format menu).
# [ui]
# animations = "subtle" # off | subtle | full
# unicode = true       # false: ASCII effect glyphs
# [ui.formats]
# "watch:counter" = "binary" # binary | octal | decimal | hex
# "register:pc" = "hex"
