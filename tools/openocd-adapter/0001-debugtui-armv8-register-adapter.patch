+COMMAND_HANDLER(aarch64_debugtui_vfp_write_command)
+{
+	if (CMD_ARGC != 2)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	struct armv8_debugtui_vfp_write_request request;
+	if (!armv8_debugtui_vfp_write_request(CMD_ARGV[0], CMD_ARGV[1], &request))
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target || !target_was_examined(target))
+		return ERROR_TARGET_NOT_EXAMINED;
+	struct arm *arm = target_to_arm(target);
+	if (!is_arm(arm) || !arm->arch_info || !is_armv8(arm->arch_info) || !arm->dpm)
+		return ERROR_TARGET_INVALID;
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	struct reg_cache *cache = arm->core_cache;
+	unsigned int index = ARMV8_V0 + request.read.pair;
+	if (!cache || cache->num_regs <= ARMV8_FPCR)
+		return ERROR_TARGET_INVALID;
+	/* GDB register assignments are deferred until resume. Do not discard them
+	 * or let a dirty vector/status cache overwrite this physical transaction. */
+	const unsigned int guarded[] = {index, ARMV8_PC, ARMV8_XPSR, ARMV8_FPSR, ARMV8_FPCR};
+	for (unsigned int i = 0; i < ARRAY_SIZE(guarded); i++) {
+		if (cache->reg_list[guarded[i]].dirty) {
+			command_print(CMD, "outcome not_sent reason pending-register-write");
+			return ERROR_OK;
+		}
+	}
+	struct armv8_debugtui_vfp_write_result result;
+	bool sent = false, uncertain = false;
+	int retval = armv8_dpm_debugtui_vfp_write(arm->dpm, &request, &result, &sent, &uncertain);
+	if (sent) {
+		struct reg *pair = &cache->reg_list[index];
+		pair->valid = false;
+		/* ARM32 D aliases share the pair's storage, but have separate validity. */
+		for (struct reg_cache *shadow = cache->next; shadow; shadow = shadow->next) {
+			for (unsigned int i = 0; i < shadow->num_regs; i++) {
+				if (shadow->reg_list[i].arch_info == pair->arch_info)
+					shadow->reg_list[i].valid = false;
+			}
+		}
+	}
+	if (uncertain) {
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: VFP write outcome unknown; reconnect required");
+		return retval == ERROR_OK ? ERROR_FAIL : retval;
+	}
+	if (retval > 0 && retval != DEBUGTUI_VFP_WRITE_MISMATCH) {
+		const char *reason = retval == DEBUGTUI_VFP_RESTRICTED ? "access-restricted" :
+			retval == DEBUGTUI_VFP_DISABLED ? "feature-disabled" :
+			retval == DEBUGTUI_VFP_NOT_IMPLEMENTED ? "not-implemented" : "writer-unsupported";
+		command_print(CMD, "outcome not_sent reason %s", reason);
+		return ERROR_OK;
+	}
+	if (retval != ERROR_OK && retval != DEBUGTUI_VFP_WRITE_MISMATCH)
+		return retval;
+	command_print(CMD, "outcome %s before 0x%016" PRIx64 "%016" PRIx64
+		" expected 0x%016" PRIx64 "%016" PRIx64 " value 0x%016" PRIx64 "%016" PRIx64
+		" mvfr0 0x%08" PRIx32 " mvfr1 0x%08" PRIx32 " fpexc 0x%08" PRIx32,
+		retval == ERROR_OK ? "verified" : "mismatch", result.before.words[1], result.before.words[0],
+		result.expected[1], result.expected[0], result.observed.words[1], result.observed.words[0],
+		result.observed.mvfr0, result.observed.mvfr1, result.observed.fpexc);
+	return ERROR_OK;
+}
+
