+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_GIC_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_GIC_H
+
+#include "armv8_debugtui_timer.h"
+
+#define DEBUGTUI_GIC_PROTOCOL "debugtui-armv8-gic-1 external-identity current-el fresh-capacity physical-icc hyp-ich no-ack no-enable stop-on-fault"
+#define DEBUGTUI_GIC_UNSUPPORTED 1
+#define DEBUGTUI_GIC_RESTRICTED 2
+#define DEBUGTUI_GIC_ACCESS_UNKNOWN 3
+#define DEBUGTUI_GIC_NOT_IMPLEMENTED 4
+
+struct armv8_debugtui_gic_register {
+	const char *name;
+	unsigned int op1, crn, crm, op2;
+	bool hyp, implemented, acknowledge;
+};
+/* R52 TRM Tables 10-69/80, 10-71/94. LR/LRC are independent 32-bit
+ * registers on this implementation, not a synthesized 64-bit MRRC view. */
+static const struct armv8_debugtui_gic_register armv8_debugtui_gic_registers[] = {
+	{"icc_ctlr", 0, 12, 12, 4, false, true, false},
+	{"icc_sre", 0, 12, 12, 5, false, true, false},
+	{"icc_hsre", 4, 12, 9, 5, false, true, false},
+	{"icc_pmr", 0, 4, 6, 0, false, true, false},
+	{"icc_rpr", 0, 12, 11, 3, false, true, false},
+	{"icc_bpr0", 0, 12, 8, 3, false, true, false},
+	{"icc_bpr1", 0, 12, 12, 3, false, true, false},
+	{"icc_igrpen0", 0, 12, 12, 6, false, true, false},
+	{"icc_igrpen1", 0, 12, 12, 7, false, true, false},
+	{"icc_hppir0", 0, 12, 8, 2, false, true, false},
+	{"icc_hppir1", 0, 12, 12, 2, false, true, false},
+	{"icc_ap0r0", 0, 12, 8, 4, false, true, false},
+	{"icc_ap0r1", 0, 12, 8, 5, false, false, false},
+	{"icc_ap0r2", 0, 12, 8, 6, false, false, false},
+	{"icc_ap0r3", 0, 12, 8, 7, false, false, false},
+	{"icc_ap1r0", 0, 12, 9, 0, false, true, false},
+	{"icc_ap1r1", 0, 12, 9, 1, false, false, false},
+	{"icc_ap1r2", 0, 12, 9, 2, false, false, false},
+	{"icc_ap1r3", 0, 12, 9, 3, false, false, false},
+	{"ich_vtr", 4, 12, 11, 1, true, true, false},
+	{"ich_hcr", 4, 12, 11, 0, true, true, false},
+	{"ich_misr", 4, 12, 11, 2, true, true, false},
+	{"ich_eisr", 4, 12, 11, 3, true, true, false},
+	{"ich_elrsr", 4, 12, 11, 5, true, true, false},
+	{"ich_vmcr", 4, 12, 11, 7, true, true, false},
+	{"ich_ap0r0", 4, 12, 8, 0, true, true, false},
+	{"ich_ap0r1", 4, 12, 8, 1, true, false, false},
+	{"ich_ap0r2", 4, 12, 8, 2, true, false, false},
+	{"ich_ap0r3", 4, 12, 8, 3, true, false, false},
+	{"ich_ap1r0", 4, 12, 9, 0, true, true, false},
+	{"ich_ap1r1", 4, 12, 9, 1, true, false, false},
+	{"ich_ap1r2", 4, 12, 9, 2, true, false, false},
+	{"ich_ap1r3", 4, 12, 9, 3, true, false, false},
+	{"ich_lr0", 4, 12, 12, 0, true, true, false},
+	{"ich_lr1", 4, 12, 12, 1, true, true, false},
+	{"ich_lr2", 4, 12, 12, 2, true, true, false},
+	{"ich_lr3", 4, 12, 12, 3, true, true, false},
+	{"ich_lrc0", 4, 12, 14, 0, true, true, false},
+	{"ich_lrc1", 4, 12, 14, 1, true, true, false},
+	{"ich_lrc2", 4, 12, 14, 2, true, true, false},
+	{"ich_lrc3", 4, 12, 14, 3, true, true, false},
+	{"icc_iar0", 0, 12, 8, 0, false, true, true},
+	{"icc_iar1", 0, 12, 12, 0, false, true, true},
+};
+struct armv8_debugtui_gic_result {
+	uint32_t midr, dscr, dspsr, dlr, id_pfr1, icc_hsre, icc_sre, icc_ctlr;
+	uint32_t ich_vtr, hcr, ich_hcr, hstr, value;
+};
+static inline const struct armv8_debugtui_gic_register *armv8_debugtui_gic_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_gic_registers) / sizeof(armv8_debugtui_gic_registers[0]); i++)
+		if (strcmp(name, armv8_debugtui_gic_registers[i].name) == 0)
+			return &armv8_debugtui_gic_registers[i];
+	return NULL;
+}
+static inline const char *armv8_debugtui_gic_reason(int reason)
+{
+	if (reason == DEBUGTUI_GIC_RESTRICTED)
+		return "debugtui-gic:access-restricted";
+	if (reason == DEBUGTUI_GIC_ACCESS_UNKNOWN)
+		return "debugtui-gic:access-unknown";
+	if (reason == DEBUGTUI_GIC_NOT_IMPLEMENTED)
+		return "debugtui-gic:not-implemented";
+	return "debugtui-gic:reader-unsupported";
+}
+static inline int armv8_debugtui_gic_transfer(const struct armv8_debugtui_timer_io *io,
+	const struct armv8_debugtui_gic_register *reg,
+	struct armv8_debugtui_gic_result *result, bool *uncertain)
+{
+	struct armv8_debugtui_gic_result sample = {0};
+	uint32_t after;
+	*uncertain = false;
+	/* IAR is an interrupt acknowledgement, not an observational read.
+	 * No legacy fallback, implicit acknowledgement or interrupt-control writes. */
+	if (reg->acknowledge)
+		return DEBUGTUI_GIC_RESTRICTED;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &sample.dscr);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(sample.dscr)) {
+		if (sample.dscr & DEBUGTUI_TIMER_FAULT_MASK) {
+			retval = -1;
+			goto fault;
+		}
+		return ((sample.dscr >> 8) & 3) == 2 && (sample.dscr & (1u << 15)) ?
+			DEBUGTUI_GIC_RESTRICTED : DEBUGTUI_GIC_UNSUPPORTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &sample.midr);
+	if (retval != 0)
+		goto fault;
+	if ((sample.midr >> 24) != 0x41 || ((sample.midr >> 16) & 15) != 15 ||
+		((sample.midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_GIC_UNSUPPORTED;
+	/* At EL1 HCR.IMO/FMO redirects ICC to ICV and HSTR/ICH_HCR can trap.
+	 * Below EL2 their permissions cannot be proven without changing EL. */
+	if (((sample.dscr >> 8) & 3) != 2)
+		return DEBUGTUI_GIC_ACCESS_UNKNOWN;
+	const uint32_t opcodes[] = {
+		DEBUGTUI_READ_DSPSR, DEBUGTUI_READ_DLR,
+		ARMV4_5_MRC(15, 0, 0, 0, 1, 1), /* ID_PFR1 */
+		ARMV4_5_MRC(15, 4, 0, 12, 9, 5), /* ICC_HSRE */
+		ARMV4_5_MRC(15, 0, 0, 12, 12, 5), /* ICC_SRE */
+		ARMV4_5_MRC(15, 0, 0, 12, 12, 4), /* physical ICC_CTLR at EL2 */
+		ARMV4_5_MRC(15, 4, 0, 12, 11, 1), /* virtual ICH_VTR */
+		ARMV4_5_MRC(15, 4, 0, 1, 1, 0), /* HCR, do not change redirection */
+		ARMV4_5_MRC(15, 4, 0, 12, 11, 0), /* ICH_HCR */
+		ARMV4_5_MRC(15, 4, 0, 1, 1, 3), /* HSTR */
+	};
+	uint32_t *proof[] = {&sample.dspsr, &sample.dlr, &sample.id_pfr1,
+		&sample.icc_hsre, &sample.icc_sre, &sample.icc_ctlr, &sample.ich_vtr,
+		&sample.hcr, &sample.ich_hcr, &sample.hstr};
+	for (unsigned int i = 0; i < 10; i++) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core, opcodes[i], false, proof[i]);
+		if (retval != 0)
+			goto fault;
+		/* Confirm implementation/enables before subsequent GIC opcodes. */
+		if ((i == 2 && (sample.id_pfr1 >> 28) != 1) ||
+			(i == 3 && sample.icc_hsre != 15) || (i == 4 && sample.icc_sre != 7) ||
+			(i == 5 && (sample.icc_ctlr & ~UINT32_C(3)) != UINT32_C(0x400)) ||
+			(i == 6 && sample.ich_vtr != UINT32_C(0x90180003)))
+			return DEBUGTUI_GIC_UNSUPPORTED;
+	}
+	if ((sample.id_pfr1 >> 28) != 1 || sample.icc_hsre != 15 || sample.icc_sre != 7 ||
+		(sample.icc_ctlr & ~UINT32_C(3)) != UINT32_C(0x400) || sample.ich_vtr != UINT32_C(0x90180003))
+		return DEBUGTUI_GIC_UNSUPPORTED;
+	if (!reg->implemented)
+		return DEBUGTUI_GIC_NOT_IMPLEMENTED;
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) || ((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+		ARMV4_5_MRC(15, reg->op1, 0, reg->crn, reg->crm, reg->op2), false, &sample.value);
+	if (retval != 0)
+		goto fault;
+	for (unsigned int i = 0; i < 10; i++) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core, opcodes[i], false, &after);
+		if (retval != 0)
+			goto fault;
+		if (*proof[i] != after) {
+			retval = -1;
+			goto fault;
+		}
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.midr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) || ((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+#endif
diff --git a/src/target/armv8_debugtui_pmu.h b/src/target/armv8_debugtui_pmu.h
new file mode 100644
index 0000000..3438d53
--- /dev/null
+++ b/src/target/armv8_debugtui_pmu.h
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_PMU_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_PMU_H
+
+#include "armv8_debugtui_timer.h"
+
+#define DEBUGTUI_PMU_PROTOCOL "debugtui-armv8-pmu-1 external-identity current-el fresh-count direct-index mrrc64 no-enable no-selector-write stop-on-fault"
+#define DEBUGTUI_PMU_UNSUPPORTED 1
+#define DEBUGTUI_PMU_RESTRICTED 2
+#define DEBUGTUI_PMU_ACCESS_UNKNOWN 3
+
+struct armv8_debugtui_pmu_register {
+	const char *name;
+	unsigned int bits, crn, crm, op2;
+};
+/* Cortex-R52 TRM 100026_0104_01_en Tables 13-1 and 4-18.
+ * Index addressing never writes PMSELR. No PMSWINC or control writer. */
+static const struct armv8_debugtui_pmu_register armv8_debugtui_pmu_registers[] = {
+	{"pmcr", 32, 9, 12, 0},
+	{"pmcntenset", 32, 9, 12, 1}, {"pmcntenclr", 32, 9, 12, 2},
+	{"pmovsr", 32, 9, 12, 3}, {"pmselr", 32, 9, 12, 5},
+	{"pmceid0", 32, 9, 12, 6}, {"pmceid1", 32, 9, 12, 7},
+	{"pmxevtyper", 32, 9, 13, 1}, {"pmxevcntr", 32, 9, 13, 2},
+	{"pmuserenr", 32, 9, 14, 0}, {"pmintenset", 32, 9, 14, 1},
+	{"pmintenclr", 32, 9, 14, 2}, {"pmovsset", 32, 9, 14, 3},
+	{"pmccfiltr", 32, 14, 15, 7},
+	{"pmevcntr0", 32, 14, 8, 0}, {"pmevcntr1", 32, 14, 8, 1},
+	{"pmevcntr2", 32, 14, 8, 2}, {"pmevcntr3", 32, 14, 8, 3},
+	{"pmevtyper0", 32, 14, 12, 0}, {"pmevtyper1", 32, 14, 12, 1},
+	{"pmevtyper2", 32, 14, 12, 2}, {"pmevtyper3", 32, 14, 12, 3},
+	{"pmccntr", 64, 0, 9, 0},
+};
+struct armv8_debugtui_pmu_result {
+	uint32_t midr, dscr, dspsr, dlr, id_dfr0, pmcr, hdcr, pmselr;
+	uint64_t value;
+};
+static inline const struct armv8_debugtui_pmu_register *armv8_debugtui_pmu_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_pmu_registers) / sizeof(armv8_debugtui_pmu_registers[0]); i++)
+		if (strcmp(name, armv8_debugtui_pmu_registers[i].name) == 0)
+			return &armv8_debugtui_pmu_registers[i];
+	return NULL;
+}
+static inline const char *armv8_debugtui_pmu_reason(int reason)
+{
+	if (reason == DEBUGTUI_PMU_RESTRICTED)
+		return "debugtui-pmu:access-restricted";
+	if (reason == DEBUGTUI_PMU_ACCESS_UNKNOWN)
+		return "debugtui-pmu:access-unknown";
+	return "debugtui-pmu:reader-unsupported";
+}
+static inline int armv8_debugtui_pmu_transfer(const struct armv8_debugtui_timer_io *io,
+	const struct armv8_debugtui_pmu_register *reg,
+	struct armv8_debugtui_pmu_result *result, bool *uncertain)
+{
+	struct armv8_debugtui_pmu_result sample = {0};
+	uint32_t after, scalar;
+	*uncertain = false;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &sample.dscr);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(sample.dscr)) {
+		if (sample.dscr & DEBUGTUI_TIMER_FAULT_MASK) {
+			retval = -1;
+			goto fault;
+		}
+		return ((sample.dscr >> 8) & 3) == 2 && (sample.dscr & (1u << 15)) ?
+			DEBUGTUI_PMU_RESTRICTED : DEBUGTUI_PMU_UNSUPPORTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &sample.midr);
+	if (retval != 0)
+		goto fault;
+	if ((sample.midr >> 24) != 0x41 || ((sample.midr >> 16) & 15) != 15 ||
+		((sample.midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_PMU_UNSUPPORTED;
+	/* Debug keeps current EL permissions/traps (DDI 0487 M.b H2.4.5/8).
+ * Below EL2 we cannot read HDCR/HSTR without changing EL, so neither
+ * HDD=0 nor the stopped DSPSR proves TPM/TPMCR/T9/HPMN permission. */
+	if (((sample.dscr >> 8) & 3) != 2)
+		return DEBUGTUI_PMU_ACCESS_UNKNOWN;
+	const uint32_t proof_opcodes[] = {
+		DEBUGTUI_READ_DSPSR, DEBUGTUI_READ_DLR,
+		ARMV4_5_MRC(15, 0, 0, 0, 1, 2), /* ID_DFR0 */
+		ARMV4_5_MRC(15, 0, 0, 9, 12, 0), /* PMCR */
+		ARMV4_5_MRC(15, 4, 0, 1, 1, 1), /* HDCR */
+		ARMV4_5_MRC(15, 0, 0, 9, 12, 5), /* PMSELR, read only */
+	};
+	uint32_t *proof[] = {&sample.dspsr, &sample.dlr, &sample.id_dfr0,
+		&sample.pmcr, &sample.hdcr, &sample.pmselr};
+	for (unsigned int i = 0; i < 6; i++) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core, proof_opcodes[i], false, proof[i]);
+		if (retval != 0)
+			goto fault;
+	}
+	if (((sample.id_dfr0 >> 24) & 15) != 3 ||
+		(sample.pmcr & UINT32_C(0xffffff80)) != UINT32_C(0x41132000) || sample.pmselr > 31)
+		return DEBUGTUI_PMU_UNSUPPORTED;
+	/* PMXEVTYPER.SEL=31 aliases PMCCFILTR. PMXEVCNTR.SEL=31 is NOT
+	 * the cycle count; R52 implements the UNDEFINED behavior (TRM p.642).
+ * Reject all unimplemented selected event indices before data access. */
+	if (reg->bits == 32 && reg->crn == 9 && reg->crm == 13 &&
+		(sample.pmselr >= 4 && !(sample.pmselr == 31 && reg->op2 == 1)))
+		return DEBUGTUI_PMU_RESTRICTED;
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	if (reg->bits == 64)
+		retval = armv8_debugtui_mrrc_transfer(&io->core, 15, 0, 9, &sample.value);
+	else {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, 0, 0, reg->crn, reg->crm, reg->op2), false, &scalar);
+		if (retval == 0)
+			sample.value = scalar;
+	}
+	if (retval != 0)
+		goto fault;
+	for (unsigned int i = 0; i < 6; i++) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core, proof_opcodes[i], false, &after);
+		if (retval != 0)
+			goto fault;
+		if (*proof[i] != after) {
+			retval = -1;
+			goto fault;
+		}
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.midr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+#endif
diff --git a/src/target/armv8_debugtui_r52.h b/src/target/armv8_debugtui_r52.h
