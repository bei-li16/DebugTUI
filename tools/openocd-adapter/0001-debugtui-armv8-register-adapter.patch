+		command_print(CMD, "debugtui-timer:%s", reason);
+		return retval == DEBUGTUI_TIMER_UNSUPPORTED ? ERROR_TARGET_INVALID : ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
