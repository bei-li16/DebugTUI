+COMMAND_HANDLER(aarch64_debugtui_r52_command)
+{
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	struct armv8_debugtui_r52_register reg;
+	if (!armv8_debugtui_r52_find(CMD_ARGV[0], &reg))
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target || !target_was_examined(target))
+		return ERROR_TARGET_NOT_EXAMINED;
+	struct arm *arm = target_to_arm(target);
+	if (!is_arm(arm) || !arm->arch_info || !is_armv8(arm->arch_info) || !arm->dpm)
+		return ERROR_TARGET_INVALID;
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	struct armv8_debugtui_r52_result result;
+	bool uncertain = false;
+	int retval = armv8_dpm_debugtui_r52(arm->dpm, &reg, &result, &uncertain);
+	if (uncertain) {
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: R52 read outcome unknown; reconnect required");
+		return retval == ERROR_OK ? ERROR_FAIL : retval;
+	}
+	if (retval > 0) {
+		command_print(CMD, "%s", armv8_debugtui_r52_reason(retval));
+		return retval == DEBUGTUI_R52_UNSUPPORTED ? ERROR_TARGET_INVALID : ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+	if (retval != ERROR_OK)
+		return retval;
+	command_print(CMD, "midr 0x%08" PRIx32 " dscr 0x%08" PRIx32
+		" dspsr 0x%08" PRIx32 " dlr 0x%08" PRIx32 " bank %s capacity 0x%08" PRIx32
+		" value 0x%08" PRIx32, result.midr, result.dscr, result.dspsr, result.dlr,
+		reg.bank < 0 ? "none" : reg.bank == 0 ? "el1" : "el2", result.capacity, result.value);
+	return ERROR_OK;
+}
