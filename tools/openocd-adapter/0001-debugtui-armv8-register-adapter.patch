+	if (retval != ERROR_OK)
+		return retval;
+	command_print(CMD, "midr 0x%08" PRIx32 " dscr 0x%08" PRIx32 " dspsr 0x%08" PRIx32
+		" dlr 0x%08" PRIx32 " value 0x%0*" PRIx64,
+		result.midr, result.dscr, result.dspsr, result.dlr, (int)(reg->bits / 4), result.value);
+	return ERROR_OK;
+}
