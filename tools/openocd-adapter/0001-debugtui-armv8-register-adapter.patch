+COMMAND_HANDLER(aarch64_debugtui_vfp_command)
+{
+	struct armv8_debugtui_vfp_request request;
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	if (!armv8_debugtui_vfp_request(CMD_ARGV[0], &request))
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target || !target_was_examined(target))
+		return ERROR_TARGET_NOT_EXAMINED;
+	struct arm *arm = target_to_arm(target);
+	if (!is_arm(arm) || !arm->arch_info || !is_armv8(arm->arch_info) || !arm->dpm)
+		return ERROR_TARGET_INVALID;
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	struct armv8_debugtui_vfp_result result;
+	bool uncertain = false;
+	int retval = armv8_dpm_debugtui_vfp(arm->dpm, &request, &result, &uncertain);
+	if (uncertain) {
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: VFP outcome unknown; reconnect required");
+		return retval;
+	}
+	if (retval > 0) {
+		const char *reason = retval == DEBUGTUI_VFP_RESTRICTED ? "access-restricted" :
+			retval == DEBUGTUI_VFP_DISABLED ? "feature-disabled" :
+			retval == DEBUGTUI_VFP_NOT_IMPLEMENTED ? "not-implemented" : "reader-unsupported";
+		command_print(CMD, "debugtui-vfp:%s", reason);
+		return retval == DEBUGTUI_VFP_UNSUPPORTED ? ERROR_TARGET_INVALID : ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	}
+	if (retval != ERROR_OK)
+		return retval;
+	if (request.data)
+		command_print(CMD, "mvfr0 0x%08" PRIx32 " mvfr1 0x%08" PRIx32 " fpexc 0x%08" PRIx32
+			" value 0x%016" PRIx64 "%016" PRIx64,
+			result.mvfr0, result.mvfr1, result.fpexc, result.words[1], result.words[0]);
+	else
+		command_print(CMD, "mvfr0 0x%08" PRIx32 " mvfr1 0x%08" PRIx32 " fpexc 0x%08" PRIx32
+			" value 0x%08" PRIx32, result.mvfr0, result.mvfr1, result.fpexc, (uint32_t)result.words[0]);
+	return ERROR_OK;
+}
