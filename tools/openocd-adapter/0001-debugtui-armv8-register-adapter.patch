+COMMAND_HANDLER(aarch64_debugtui_adapter_command)
+{
+	if (CMD_ARGC != 0)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	command_print(CMD, "debugtui-armv8-1 mrrc isb scratch-readback stop-on-fault");
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(aarch64_debugtui_access_command)
+{
+	bool mrrc = strcmp(CMD_NAME, "mrrc") == 0;
+	if (CMD_ARGC != (mrrc ? 3 : 0))
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	unsigned int cp = 0, op1 = 0, crm = 0;
+	if (mrrc) {
+		COMMAND_PARSE_NUMBER(uint, CMD_ARGV[0], cp);
+		COMMAND_PARSE_NUMBER(uint, CMD_ARGV[1], op1);
+		COMMAND_PARSE_NUMBER(uint, CMD_ARGV[2], crm);
+		if (cp > 15 || op1 > 15 || crm > 15)
+			return ERROR_COMMAND_ARGUMENT_INVALID;
+	}
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target || !target_was_examined(target))
+		return ERROR_TARGET_NOT_EXAMINED;
+	struct arm *arm = target_to_arm(target);
+	if (!is_arm(arm) || !arm->arch_info || !is_armv8(arm->arch_info) || !arm->dpm)
+		return ERROR_FAIL;
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	if (mrrc && arm->core_state == ARM_STATE_AARCH64)
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	uint64_t value = 0;
+	int retval = mrrc ? armv8_dpm_debugtui_mrrc(arm->dpm, cp, op1, crm, &value) :
+		armv8_dpm_debugtui_isb(arm->dpm);
+	if (retval != ERROR_OK) {
+		/* Never present an uncertain instruction/restore as an ordinary missing
+		 * register. No additional injected instruction or automatic retry. */
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: DebugTUI adapter outcome unknown; reconnect/reset required");
+		return retval;
+	}
+	if (mrrc)
+		command_print(CMD, "0x%016" PRIx64, value);
+	return ERROR_OK;
+}
+
+COMMAND_HANDLER(aarch64_debugtui_banked_protocol_command)
+{
