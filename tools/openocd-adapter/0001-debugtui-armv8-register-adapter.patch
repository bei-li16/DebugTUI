diff --git a/src/target/armv8_debugtui.h b/src/target/armv8_debugtui.h
new file mode 100644
index 0000000..9e0dde2
--- /dev/null
+++ b/src/target/armv8_debugtui.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "arm_opcodes.h"
+
+/* Transport-independent transaction, also compiled by the fault-injection test.
+ * A failed transfer stops immediately: exception state/transport completion is
+ * unknown, so neither a speculative rollback nor automatic retry is safe. */
+struct armv8_debugtui_io {
+	void *context;
+	int (*read_gpr)(void *context, unsigned int reg, uint32_t *value);
+	int (*write_gpr)(void *context, unsigned int reg, uint32_t value);
+	int (*execute)(void *context, uint32_t opcode);
+};
+
+static inline bool armv8_debugtui_mrrc_encoding_valid(unsigned int cp,
+	unsigned int op1, unsigned int crm)
+{
+	return cp <= 15 && op1 <= 15 && crm <= 15;
+}
+
+static inline int armv8_debugtui_mrc_mcr_transfer(const struct armv8_debugtui_io *io,
+	uint32_t opcode, bool write, uint32_t *value)
+{
+	uint32_t saved, result = 0, restored;
+	int retval = io->read_gpr(io->context, 0, &saved);
+	if (retval != 0)
+		return retval;
+	if (write) {
+		retval = io->write_gpr(io->context, 0, *value);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->execute(io->context, opcode);
+	if (retval != 0)
+		return retval;
+	if (!write) {
+		retval = io->read_gpr(io->context, 0, &result);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->write_gpr(io->context, 0, saved);
+	if (retval != 0)
+		return retval;
+	retval = io->read_gpr(io->context, 0, &restored);
+	if (retval != 0)
+		return retval;
+	if (restored != saved)
+		return -1;
+	if (!write)
+		*value = result;
+	return 0;
+}
+
+static inline int armv8_debugtui_mrrc_transfer(const struct armv8_debugtui_io *io,
+	unsigned int cp, unsigned int op1, unsigned int crm, uint64_t *value)
+{
+	uint32_t saved[2], result[2], restored[2];
+	int retval;
+
+	/* Read physical scratch values, including any changes from earlier debugger
+	 * commands. Do not substitute logical register-cache values. */
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &saved[i]);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->execute(io->context, ARMV5_T_MRRC(cp, op1, 0, 1, crm));
+	if (retval != 0)
+		return retval;
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &result[i]);
+		if (retval != 0)
+			return retval;
+	}
+	/* R0 is restored last, then both registers are physically read back. */
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, saved[i - 1]);
+		if (retval != 0)
+			return retval;
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &restored[i]);
+		if (retval != 0)
+			return retval;
+		if (restored[i] != saved[i])
+			return -1;
+	}
+	*value = ((uint64_t)result[1] << 32) | result[0];
+	return 0;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_banked.h b/src/target/armv8_debugtui_banked.h
new file mode 100644
index 0000000..f293869
--- /dev/null
+++ b/src/target/armv8_debugtui_banked.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_BANKED_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_BANKED_H
+
+#include <string.h>
+#include "armv8_debugtui.h"
+
+#define DEBUGTUI_BANKED_PROTOCOL "debugtui-armv8-banked-1 mrs physical-readback no-mode-change stop-on-fault"
+#define DEBUGTUI_BANKED_UNSUPPORTED 1
+#define DEBUGTUI_BANKED_UNAVAILABLE 2
+#define DEBUGTUI_READ_DSPSR ARMV4_5_MRC(15, 3, 0, 4, 5, 0)
+#define DEBUGTUI_MRS_SPSR UINT32_C(0xf3ff8000)
+
+struct armv8_debugtui_bank {
+	const char *name;
+	unsigned int mode, gpr, sysm;
+	bool spsr;
+};
+
+/* DDI 0568A.c H1 BankedRegisterAccessValid/SPSRaccessValid. No Monitor
+ * mode exists on R52. Current banks use ordinary MOV/MRS, never an invalid
+ * banked MRS of the current bank. Hyp LR is the shared User LR, not ELR_hyp. */
+static const struct armv8_debugtui_bank armv8_debugtui_banks[] = {
+	{"r8_usr", 0x10, 8, 0, false}, {"r9_usr", 0x10, 9, 1, false},
+	{"r10_usr", 0x10, 10, 2, false}, {"r11_usr", 0x10, 11, 3, false},
+	{"r12_usr", 0x10, 12, 4, false}, {"sp_usr", 0x10, 13, 5, false},
+	{"lr_usr", 0x10, 14, 6, false},
+	{"r8_fiq", 0x11, 8, 8, false}, {"r9_fiq", 0x11, 9, 9, false},
+	{"r10_fiq", 0x11, 10, 10, false}, {"r11_fiq", 0x11, 11, 11, false},
+	{"r12_fiq", 0x11, 12, 12, false}, {"sp_fiq", 0x11, 13, 13, false},
+	{"lr_fiq", 0x11, 14, 14, false}, {"spsr_fiq", 0x11, 0, 14, true},
+	{"lr_irq", 0x12, 14, 16, false}, {"sp_irq", 0x12, 13, 17, false},
+	{"spsr_irq", 0x12, 0, 16, true},
+	{"lr_svc", 0x13, 14, 18, false}, {"sp_svc", 0x13, 13, 19, false},
+	{"spsr_svc", 0x13, 0, 18, true},
+	{"lr_abt", 0x17, 14, 20, false}, {"sp_abt", 0x17, 13, 21, false},
+	{"spsr_abt", 0x17, 0, 20, true},
+	{"lr_und", 0x1b, 14, 22, false}, {"sp_und", 0x1b, 13, 23, false},
+	{"spsr_und", 0x1b, 0, 22, true},
+	{"elr_hyp", 0x1a, 0, 30, false}, {"sp_hyp", 0x1a, 13, 31, false},
+	{"spsr_hyp", 0x1a, 0, 30, true},
+};
+
+static inline const struct armv8_debugtui_bank *armv8_debugtui_bank_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_banks) / sizeof(armv8_debugtui_banks[0]); i++)
+		if (strcmp(armv8_debugtui_banks[i].name, name) == 0)
+			return &armv8_debugtui_banks[i];
+	return NULL;
+}
+
+static inline int armv8_debugtui_bank_opcode(const struct armv8_debugtui_bank *bank,
+	unsigned int mode, uint32_t *opcode)
+{
+	if (mode != 0x10 && mode != 0x11 && mode != 0x12 && mode != 0x13 &&
+		mode != 0x17 && mode != 0x1a && mode != 0x1b && mode != 0x1f)
+		return DEBUGTUI_BANKED_UNSUPPORTED;
+	bool current = bank->mode == mode || (bank->mode == 0x10 &&
+		((bank->gpr <= 12 && mode != 0x11) || mode == 0x1f ||
+		 (bank->gpr == 14 && mode == 0x1a)));
+	if (current && strcmp(bank->name, "elr_hyp") != 0) {
+		*opcode = bank->spsr ? DEBUGTUI_MRS_SPSR : UINT32_C(0xea4f0000) | bank->gpr;
+		return 0;
+	}
+	if (mode == 0x10 || (bank->mode == 0x1a && mode != 0x1a))
+		return DEBUGTUI_BANKED_UNAVAILABLE;
+	*opcode = UINT32_C(0xf3e08020) | ((bank->sysm & 15) << 16) |
+		((bank->sysm & 16) << 0) | (bank->spsr ? UINT32_C(0x00100000) : 0);
+	return 0;
+}
+
+static inline int armv8_debugtui_bank_transfer(const struct armv8_debugtui_io *io,
+	const struct armv8_debugtui_bank *bank, uint32_t *value, bool *uncertain)
+{
+	uint32_t before = 0, after = 0, midr = 0, opcode = 0, result = 0;
+	*uncertain = false;
+	/* DSPSR is accessible at every EL in Debug state and contains the entire
+	 * stopped CPSR. Ordinary MRS CPSR masks execution bits and cannot safely
+	 * determine User mode. R52 TRM c4, op1=3,c5,op2=0. */
+	int retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &before);
+	if (retval != 0)
+		goto fault;
+	/* No privileged MIDR or banked MRS is attempted from User mode. Its
+	 * current registers remain available through the ordinary Core view. */
+	if ((before & 31) == 0x10)
+		return DEBUGTUI_BANKED_UNAVAILABLE;
+	retval = armv8_debugtui_bank_opcode(bank, before & 31, &opcode);
+	if (retval != 0)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, ARMV4_5_MRC(15, 0, 0, 0, 0, 0), false, &midr);
+	if (retval != 0)
+		goto fault;
+	if ((midr >> 24) != 0x41 || ((midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_BANKED_UNSUPPORTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, opcode, false, &result);
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (before != after) {
+		retval = -1;
+		goto fault;
+	}
+	*value = result;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_timer.h b/src/target/armv8_debugtui_timer.h
new file mode 100644
index 0000000..b9587b4
--- /dev/null
+++ b/src/target/armv8_debugtui_timer.h
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_TIMER_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_TIMER_H
+
+#include "armv8_debugtui_banked.h"
+
+#define DEBUGTUI_TIMER_PROTOCOL "debugtui-armv8-timer-1 external-identity current-el dspsr dlr scratch-readback no-mode-change stop-on-fault"
+#define DEBUGTUI_TIMER_UNSUPPORTED 1
+#define DEBUGTUI_TIMER_RESTRICTED 2
+#define DEBUGTUI_TIMER_ACCESS_UNKNOWN 3
+#define DEBUGTUI_TIMER_DSCR UINT32_C(0x088)
+#define DEBUGTUI_TIMER_MIDR UINT32_C(0xd00)
+#define DEBUGTUI_TIMER_STATE_MASK UINT32_C(0x00053f00)
+#define DEBUGTUI_TIMER_FAULT_MASK UINT32_C(0x1c0000c0)
+#define DEBUGTUI_READ_DLR ARMV4_5_MRC(15, 3, 0, 4, 5, 1)
+
+struct armv8_debugtui_timer_register {
+	const char *name;
+	unsigned int bits, op1, crm, op2, min_el;
+	bool physical;
+};
+
+/* R52 TRM 100026_0104_01, Table 11-1; DDI 0568A.c Table E1-1.
+ * "physical" requires CNTHCTL permission below EL2. CRn/CRm=14 is
+ * excluded from HSTR coarse traps (DDI 0568A.c H1-255). */
+static const struct armv8_debugtui_timer_register armv8_debugtui_timers[] = {
+	{"cntfrq", 32, 0, 0, 0, 0, false},
+	{"cntkctl", 32, 0, 1, 0, 1, false},
+	{"cntp_tval", 32, 0, 2, 0, 0, true},
+	{"cntp_ctl", 32, 0, 2, 1, 0, true},
+	{"cntv_tval", 32, 0, 3, 0, 0, false},
+	{"cntv_ctl", 32, 0, 3, 1, 0, false},
+	{"cnthctl", 32, 4, 1, 0, 2, false},
+	{"cnthp_tval", 32, 4, 2, 0, 2, false},
+	{"cnthp_ctl", 32, 4, 2, 1, 2, false},
+	{"cntpct", 64, 0, 14, 0, 0, true},
+	{"cntvct", 64, 1, 14, 0, 0, false},
+	{"cntp_cval", 64, 2, 14, 0, 0, true},
+	{"cntv_cval", 64, 3, 14, 0, 0, false},
+	{"cntvoff", 64, 4, 14, 0, 2, false},
+	{"cnthp_cval", 64, 6, 14, 0, 2, false},
+};
+
+struct armv8_debugtui_timer_io {
+	struct armv8_debugtui_io core;
+	/* External debug AP reads, never an injected CP15 identity/control read.
+ * The transport also verifies physical EDPRSR.HALT on every call. */
+	int (*read_debug)(void *context, uint32_t offset, uint32_t *value);
+};
+struct armv8_debugtui_timer_result {
+	uint32_t midr, dscr, dspsr, dlr;
+	uint64_t value;
+};
+
+static inline const struct armv8_debugtui_timer_register *armv8_debugtui_timer_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_timers) / sizeof(armv8_debugtui_timers[0]); i++)
+		if (strcmp(name, armv8_debugtui_timers[i].name) == 0)
+			return &armv8_debugtui_timers[i];
+	return NULL;
+}
+
+static inline bool armv8_debugtui_timer_state_valid(uint32_t dscr)
+{
+	unsigned int el = (dscr >> 8) & 3;
+	return el <= 2 && !(dscr & DEBUGTUI_TIMER_FAULT_MASK) && (dscr & (1u << 24)) &&
+		!(dscr & (1u << (10 + el))) && !(el == 2 && (dscr & (1u << 16)));
+}
+
+static inline int armv8_debugtui_timer_permission(const struct armv8_debugtui_timer_register *reg,
+	uint32_t dscr)
+{
+	unsigned int el = (dscr >> 8) & 3;
+	if (el < reg->min_el)
+		return DEBUGTUI_TIMER_RESTRICTED;
+	/* DDI 0487 M.b H2.4.5/8: system registers keep current EL permissions,
+ * including traps. HDD=0 does NOT bypass CNTHCTL or CNTKCTL. EL0's
+ * CNTKCTL and EL1's CNTHCTL cannot be read here without changing EL.
+ * Keep these enables unknown; never infer them from a cached CPSR/fact. */
+	if (el == 0 || (el == 1 && reg->physical))
+		return DEBUGTUI_TIMER_ACCESS_UNKNOWN;
+	return 0;
+}
+
+static inline int armv8_debugtui_timer_transfer(const struct armv8_debugtui_timer_io *io,
+	const struct armv8_debugtui_timer_register *reg,
+	struct armv8_debugtui_timer_result *result, bool *uncertain)
+{
+	struct armv8_debugtui_timer_result sample = {0};
+	uint32_t after, scalar = 0;
+	*uncertain = false;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &sample.dscr);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(sample.dscr)) {
+		if (sample.dscr & DEBUGTUI_TIMER_FAULT_MASK) {
+			retval = -1;
+			goto fault;
+		}
+		return DEBUGTUI_TIMER_UNSUPPORTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &sample.midr);
+	if (retval != 0)
+		goto fault;
+	if ((sample.midr >> 24) != 0x41 || ((sample.midr >> 16) & 15) != 15 ||
+		((sample.midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_TIMER_UNSUPPORTED;
+	retval = armv8_debugtui_timer_permission(reg, sample.dscr);
+	if (retval != 0)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &sample.dspsr);
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DLR, false, &sample.dlr);
+	if (retval != 0)
+		goto fault;
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	if (reg->bits == 64)
+		retval = armv8_debugtui_mrrc_transfer(&io->core, 15, reg->op1, reg->crm, &sample.value);
+	else {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, reg->op1, 0, 14, reg->crm, reg->op2), false, &scalar);
+		sample.value = scalar;
+	}
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.dspsr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DLR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.dlr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.midr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_vfp.h b/src/target/armv8_debugtui_vfp.h
new file mode 100644
index 0000000..70f517c
--- /dev/null
+++ b/src/target/armv8_debugtui_vfp.h
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_H
+
+#include "armv8_debugtui_banked.h"
+
+#define DEBUGTUI_VFP_PROTOCOL "debugtui-armv8-vfp-1 vmrs pair-readback dspsr no-enable stop-on-fault"
+#define DEBUGTUI_VFP_UNSUPPORTED 1
+#define DEBUGTUI_VFP_RESTRICTED 2
+#define DEBUGTUI_VFP_DISABLED 3
+#define DEBUGTUI_VFP_NOT_IMPLEMENTED 4
+#define DEBUGTUI_VMRS(reg) (UINT32_C(0xeef00a10) | ((reg) << 16))
+#define DEBUGTUI_READ_HCPTR ARMV4_5_MRC(15, 4, 0, 1, 1, 2)
+
+struct armv8_debugtui_vfp_request {
+	unsigned int control, pair, lane;
+	bool data, quad;
+};
+
+struct armv8_debugtui_vfp_result {
+	uint64_t words[2];
+	uint32_t mvfr0, mvfr1, fpexc, hcptr, dspsr;
+	bool neon;
+};
+
+static inline bool armv8_debugtui_vfp_request(const char *name,
+	struct armv8_debugtui_vfp_request *request)
+{
+	memset(request, 0, sizeof(*request));
+	const struct { const char *name; unsigned int reg; } controls[] = {
+		{"fpsid", 0}, {"fpscr", 1}, {"mvfr0", 7}, {"mvfr1", 6}, {"mvfr2", 5}, {"fpexc", 8},
+	};
+	for (unsigned int i = 0; i < sizeof(controls) / sizeof(controls[0]); i++) {
+		if (!strcmp(name, controls[i].name)) {
+			request->control = controls[i].reg;
+			return true;
+		}
+	}
+	if (name[0] != 'd' && name[0] != 'q')
+		return false;
+	size_t length = strlen(name);
+	if (length != 2 && length != 3)
+		return false;
+	if (name[1] < '0' || name[1] > '9' || (length == 3 &&
+		(name[1] == '0' || name[2] < '0' || name[2] > '9')))
+		return false;
+	unsigned int index = name[1] - '0';
+	if (length == 3)
+		index = index * 10 + name[2] - '0';
+	request->quad = name[0] == 'q';
+	if (index >= (request->quad ? 16u : 32u))
+		return false;
+	request->data = true;
+	request->pair = request->quad ? index : index / 2;
+	request->lane = request->quad ? 0 : index % 2;
+	return true;
+}
+
+static inline int armv8_debugtui_vfp_features(uint32_t mvfr0, uint32_t mvfr1,
+	unsigned int *registers, bool *neon)
+{
+	unsigned int count = mvfr0 & 15, sp = (mvfr0 >> 4) & 15, dp = (mvfr0 >> 8) & 15;
+	uint32_t simd = mvfr1 & UINT32_C(0x000fff00);
+	/* R52 TRM 16.5/16.6 and DDI 0568 D1.3: D16 SP-only or D32 + NEON.
+	 * Unknown or contradictory encodings never authorize optional D/Q access. */
+	if (sp == 2 && count == 1 && dp == 0 && simd == 0) {
+		*registers = 16;
+		*neon = false;
+	} else if (sp == 2 && count == 2 && dp == 2 && simd == UINT32_C(0x00011100)) {
+		*registers = 32;
+		*neon = true;
+	} else {
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	}
+	return 0;
+}
+
+static inline int armv8_debugtui_vfp_transfer(const struct armv8_debugtui_io *io,
+	const struct armv8_debugtui_vfp_request *request,
+	struct armv8_debugtui_vfp_result *result, bool *uncertain)
+{
+	uint32_t before, after, midr, hcptr, mvfr0, mvfr1, fpexc;
+	struct armv8_debugtui_vfp_result sample = {0};
+	unsigned int registers = 0;
+	bool neon = false;
+	*uncertain = false;
+	int retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &before);
+	if (retval)
+		goto fault;
+	/* Hyp permits direct trap inspection. Other modes require another proven
+	 * reader/policy; do not inject inaccessible HCPTR or guess Guest permissions. */
+	if ((before & 31) != 0x1a)
+		return DEBUGTUI_VFP_RESTRICTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, ARMV4_5_MRC(15, 0, 0, 0, 0, 0), false, &midr);
+	if (retval)
+		goto fault;
+	if ((midr >> 24) != 0x41 || ((midr >> 4) & 0xfff) != 0xd13 || ((midr >> 16) & 15) != 15)
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_HCPTR, false, &hcptr);
+	if (retval)
+		goto fault;
+	if (hcptr & (1u << 10))
+		return DEBUGTUI_VFP_RESTRICTED; /* VMRS is also undefined in Hyp when TCP10=1. */
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(7), false, &mvfr0);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(6), false, &mvfr1);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_vfp_features(mvfr0, mvfr1, &registers, &neon);
+	if (retval && request->data)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(8), false, &fpexc);
+	if (retval)
+		goto fault;
+	if (request->data && (request->pair * 2 >= registers || (request->quad && !neon)))
+		return DEBUGTUI_VFP_NOT_IMPLEMENTED;
+	if ((request->data || request->control == 1) && !(fpexc & (1u << 30)))
+		return DEBUGTUI_VFP_DISABLED;
+	if (request->data) {
+		/* VMOV Rt,Rt2,Dn is permitted even by the SP-only instruction subset.
+		 * Read both D lanes once so all overlapping views share one raw sample.
+		 * VMOV is VFP, not an Advanced SIMD instruction; TASE is not bypassed
+		 * to execute NEON arithmetic. Q is only an implemented storage view. */
+		for (unsigned int i = 0; i < 2; i++) {
+			unsigned int index = request->pair * 2 + i;
+			retval = armv8_debugtui_mrrc_transfer(io, 11, 1 | ((index >> 4) << 1),
+				index & 15, &sample.words[i]);
+			if (retval)
+				goto fault;
+		}
+	} else {
+		uint32_t value;
+		if (request->control == 7)
+			value = mvfr0;
+		else if (request->control == 6)
+			value = mvfr1;
+		else if (request->control == 8)
+			value = fpexc;
+		else {
+			retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(request->control), false, &value);
+			if (retval)
+				goto fault;
+		}
+		sample.words[0] = value;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(8), false, &after);
+	if (retval)
+		goto fault;
+	if (after != fpexc)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_HCPTR, false, &after);
+	if (retval)
+		goto fault;
+	if (after != hcptr)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval)
+		goto fault;
+	if (before != after)
+		goto mismatch;
+	sample.mvfr0 = mvfr0;
+	sample.mvfr1 = mvfr1;
+	sample.fpexc = fpexc;
+	sample.hcptr = hcptr;
+	sample.dspsr = before;
+	sample.neon = neon;
+	*result = sample;
+	return 0;
+mismatch:
+	retval = -1;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_vfp_write.h b/src/target/armv8_debugtui_vfp_write.h
new file mode 100644
index 0000000..636b2c7
--- /dev/null
+++ b/src/target/armv8_debugtui_vfp_write.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_WRITE_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_WRITE_H
+
+#include "armv8_debugtui_vfp.h"
+
+#define DEBUGTUI_VFP_WRITE_PROTOCOL "debugtui-armv8-vfp-write-1 vmov raw-pair fresh-merge scratch-readback no-enable stop-on-fault"
+#define DEBUGTUI_VFP_WRITE_MISMATCH 5
+
+struct armv8_debugtui_vfp_write_request {
+	struct armv8_debugtui_vfp_request read;
+	unsigned int bits, shift;
+	uint64_t value[2];
+};
+
+struct armv8_debugtui_vfp_write_result {
+	struct armv8_debugtui_vfp_result before, observed;
+	uint64_t expected[2];
+};
+
+/* Only canonical fixed-width raw bits reach an instruction. No expression,
+ * floating-point conversion, control register, sign, whitespace or Tcl input. */
+static inline bool armv8_debugtui_vfp_write_request(const char *name, const char *raw,
+	struct armv8_debugtui_vfp_write_request *request)
+{
+	memset(request, 0, sizeof(*request));
+	if (name[0] == 's') {
+		char alias[4];
+		size_t length = strlen(name);
+		if ((length != 2 && length != 3) || name[1] < '0' || name[1] > '9' ||
+			(length == 3 && (name[1] == '0' || name[2] < '0' || name[2] > '9')))
+			return false;
+		unsigned int index = name[1] - '0';
+		if (length == 3)
+			index = index * 10 + name[2] - '0';
+		if (index >= 32)
+			return false;
+		unsigned int d = index / 2;
+		alias[0] = 'd';
+		alias[1] = '0' + (d >= 10 ? d / 10 : d);
+		alias[2] = d >= 10 ? '0' + d % 10 : '\0';
+		alias[3] = '\0';
+		if (!armv8_debugtui_vfp_request(alias, &request->read))
+			return false;
+		request->bits = 32;
+		request->shift = (index % 2) * 32;
+	} else {
+		if (!armv8_debugtui_vfp_request(name, &request->read) || !request->read.data)
+			return false;
+		request->bits = request->read.quad ? 128 : 64;
+	}
+	unsigned int digits = request->bits / 4;
+	if (strlen(raw) != digits + 2 || raw[0] != '0' || raw[1] != 'x')
+		return false;
+	for (unsigned int i = 0; i < digits; i++) {
+		char c = raw[i + 2];
+		unsigned int digit;
+		if (c >= '0' && c <= '9')
+			digit = c - '0';
+		else if (c >= 'a' && c <= 'f')
+			digit = c - 'a' + 10;
+		else if (c >= 'A' && c <= 'F')
+			digit = c - 'A' + 10;
+		else
+			return false;
+		unsigned int word = (digits - 1 - i) / 16;
+		request->value[word] = (request->value[word] << 4) | digit;
+	}
+	return true;
+}
+
+/* VMOV Dn,R0,R1 is a bit transfer permitted in the D16 SP-only subset.
+ * Save physical scratch registers and verify restoration before proceeding.
+ * A failing write/execute may have completed: stop, never retry or roll back. */
+static inline int armv8_debugtui_vfp_write_double(const struct armv8_debugtui_io *io,
+	unsigned int index, uint64_t value, bool *sent)
+{
+	uint32_t saved[2], restored;
+	int retval;
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &saved[i]);
+		if (retval)
+			return retval;
+	}
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, (uint32_t)(value >> ((i - 1) * 32)));
+		if (retval)
+			return retval;
+	}
+	*sent = true;
+	retval = io->execute(io->context, ARMV5_T_MCRR(11, 1 | ((index >> 4) << 1), 0, 1, index & 15));
+	if (retval)
+		return retval;
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, saved[i - 1]);
+		if (retval)
+			return retval;
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &restored);
+		if (retval)
+			return retval;
+		if (restored != saved[i])
+			return -1;
+	}
+	return 0;
+}
+
+static inline int armv8_debugtui_vfp_write_transfer(const struct armv8_debugtui_io *io,
+	const struct armv8_debugtui_vfp_write_request *request,
+	struct armv8_debugtui_vfp_write_result *result, bool *sent, bool *uncertain)
+{
+	struct armv8_debugtui_vfp_write_result sample = {0};
+	*sent = false;
+	*uncertain = false;
+	int retval = armv8_debugtui_vfp_transfer(io, &request->read, &sample.before, uncertain);
+	if (retval)
+		return retval;
+	memcpy(sample.expected, sample.before.words, sizeof(sample.expected));
+	unsigned int lane = request->read.lane;
+	if (request->bits == 32) {
+		uint64_t mask = UINT64_C(0xffffffff) << request->shift;
+		sample.expected[lane] = (sample.expected[lane] & ~mask) | (request->value[0] << request->shift);
+	} else if (request->bits == 64) {
+		sample.expected[lane] = request->value[0];
+	} else {
+		memcpy(sample.expected, request->value, sizeof(sample.expected));
+	}
+	/* S/D write one D only. Q is explicitly two physical writes, not atomic. */
+	unsigned int count = request->bits == 128 ? 2 : 1;
+	for (unsigned int i = 0; i < count; i++) {
+		unsigned int selected = request->bits == 128 ? i : lane;
+		retval = armv8_debugtui_vfp_write_double(io, request->read.pair * 2 + selected,
+			sample.expected[selected], sent);
+		if (retval)
+			goto fault;
+	}
+	retval = armv8_debugtui_vfp_transfer(io, &request->read, &sample.observed, uncertain);
+	if (retval)
+		goto fault; /* Even a safe refusal now follows a possibly completed write. */
+	if (sample.before.dspsr != sample.observed.dspsr || sample.before.hcptr != sample.observed.hcptr ||
+		sample.before.fpexc != sample.observed.fpexc || sample.before.mvfr0 != sample.observed.mvfr0 ||
+		sample.before.mvfr1 != sample.observed.mvfr1) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return memcmp(sample.expected, sample.observed.words, sizeof(sample.expected)) ?
+		DEBUGTUI_VFP_WRITE_MISMATCH : 0;
+fault:
+	*uncertain = true;
+	return retval < 0 ? retval : -1;
+}
+
+#endif
