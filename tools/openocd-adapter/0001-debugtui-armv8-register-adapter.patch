+static int dpmv8_exec_opcode(struct arm_dpm *dpm,
+	uint32_t opcode, uint32_t *p_dscr)
+{
+	return dpmv8_exec_opcode_checked(dpm, opcode, p_dscr, true);
+}
+
+struct dpmv8_debugtui_context {
+	struct arm_dpm *dpm;
+	uint32_t execution_state;
+};
+
+static int dpmv8_debugtui_execute(void *context, uint32_t opcode)
+{
+	struct dpmv8_debugtui_context *io = context;
+	/* Do not run the legacy exception recovery/mode switch for this access. */
+	int retval = dpmv8_exec_opcode_checked(io->dpm, opcode, NULL, false);
+	if (retval == ERROR_OK &&
+		(io->dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE)) != io->execution_state)
+		return ERROR_FAIL;
+	return retval;
+}
+
+static int dpmv8_debugtui_read_gpr(void *context, unsigned int reg, uint32_t *value)
+{
+	struct dpmv8_debugtui_context *io = context;
+	int retval = dpmv8_debugtui_execute(context, ARMV4_5_MCR(14, 0, reg, 0, 5, 0));
+	if (retval != ERROR_OK)
+		return retval;
+	return dpmv8_read_dcc(io->dpm->arm->arch_info, value, &io->dpm->dscr);
+}
+
+static int dpmv8_debugtui_write_gpr(void *context, unsigned int reg, uint32_t value)
+{
+	struct dpmv8_debugtui_context *io = context;
+	int retval = dpmv8_write_dcc(io->dpm->arm->arch_info, value);
+	if (retval != ERROR_OK)
+		return retval;
+	return dpmv8_debugtui_execute(context, ARMV4_5_MRC(14, 0, reg, 0, 5, 0));
+}
+
+static int dpmv8_debugtui_prepare(struct arm_dpm *dpm)
+{
+	struct armv8_common *armv8 = dpm->arm->arch_info;
+	uint32_t prsr;
+	int retval = mem_ap_read_atomic_u32(armv8->debug_ap,
+		armv8->debug_base + CPUV8_DBG_PRSR, &prsr);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!(prsr & PRSR_HALT))
+		return ERROR_TARGET_NOT_HALTED;
+	return dpm->prepare(dpm);
+}
+
+int armv8_dpm_debugtui_mrrc(struct arm_dpm *dpm, unsigned int cp,
+	unsigned int op1, unsigned int crm, uint64_t *value)
+{
+	if (!armv8_debugtui_mrrc_encoding_valid(cp, op1, crm))
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK)
+		return retval;
+	if (armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64)
+		return ERROR_FAIL;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE),
+	};
+	struct armv8_debugtui_io io = {
+		.context = &context,
+		.read_gpr = dpmv8_debugtui_read_gpr,
+		.write_gpr = dpmv8_debugtui_write_gpr,
+		.execute = dpmv8_debugtui_execute,
+	};
+	retval = armv8_debugtui_mrrc_transfer(&io, cp, op1, crm, value);
+	if (retval != ERROR_OK)
+		return retval;
+	return dpm->finish(dpm);
+}
+
+int armv8_dpm_debugtui_mrc_mcr(struct arm_dpm *dpm, uint32_t opcode,
+	bool write, uint32_t *value)
+{
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK)
+		return retval;
+	if (armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64)
+		return ERROR_FAIL;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE),
+	};
+	struct armv8_debugtui_io io = {
+		.context = &context,
+		.read_gpr = dpmv8_debugtui_read_gpr,
+		.write_gpr = dpmv8_debugtui_write_gpr,
+		.execute = dpmv8_debugtui_execute,
+	};
+	retval = armv8_debugtui_mrc_mcr_transfer(&io, opcode, write, value);
+	if (retval != ERROR_OK)
+		return retval;
+	return dpm->finish(dpm);
+}
+
+int armv8_dpm_debugtui_banked(struct arm_dpm *dpm,
+	const struct armv8_debugtui_bank *bank, uint32_t *value, bool *uncertain)
+{
+	*uncertain = false;
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK) {
+		*uncertain = retval != ERROR_TARGET_NOT_HALTED;
+		return retval;
+	}
+	if (armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64)
+		return DEBUGTUI_BANKED_UNSUPPORTED;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE),
+	};
+	struct armv8_debugtui_io io = {
+		.context = &context,
+		.read_gpr = dpmv8_debugtui_read_gpr,
+		.write_gpr = dpmv8_debugtui_write_gpr,
+		.execute = dpmv8_debugtui_execute,
+	};
+	retval = armv8_debugtui_bank_transfer(&io, bank, value, uncertain);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = dpm->finish(dpm);
+	if (retval != ERROR_OK)
+		*uncertain = true;
+	return retval;
+}
+
+int armv8_dpm_debugtui_vfp(struct arm_dpm *dpm,
+	const struct armv8_debugtui_vfp_request *request,
+	struct armv8_debugtui_vfp_result *result, bool *uncertain)
+{
+	*uncertain = false;
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK) {
+		*uncertain = retval != ERROR_TARGET_NOT_HALTED;
+		return retval;
+	}
+	if (armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64)
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE),
+	};
+	struct armv8_debugtui_io io = {
+		.context = &context, .read_gpr = dpmv8_debugtui_read_gpr,
+		.write_gpr = dpmv8_debugtui_write_gpr, .execute = dpmv8_debugtui_execute,
+	};
+	retval = armv8_debugtui_vfp_transfer(&io, request, result, uncertain);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = dpm->finish(dpm);
+	if (retval != ERROR_OK)
+		*uncertain = true;
+	return retval;
+}
+
+int armv8_dpm_debugtui_isb(struct arm_dpm *dpm)
+{
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK)
+		return retval;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE),
+	};
+	uint32_t opcode = armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64 ?
+		ARMV8_ISB : ARMV8_ISB_SY_T1;
+	retval = dpmv8_debugtui_execute(&context, opcode);
+	if (retval != ERROR_OK)
+		return retval;
+	return dpm->finish(dpm);
+}
+
 static int dpmv8_instr_execute(struct arm_dpm *dpm, uint32_t opcode)
 {
 	return dpmv8_exec_opcode(dpm, opcode, NULL);
