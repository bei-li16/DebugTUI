+	const struct armv8_debugtui_gic_register *reg,
+	struct armv8_debugtui_gic_result *result, bool *uncertain)
+{
+	*uncertain = false;
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK) {
+		*uncertain = retval != ERROR_TARGET_NOT_HALTED;
+		return retval;
+	}
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE | DSCR_SDD | (1u << 15)),
+	};
+	struct armv8_debugtui_timer_io io = {
+		.core = {.context = &context, .read_gpr = dpmv8_debugtui_read_gpr,
+			.write_gpr = dpmv8_debugtui_write_gpr, .execute = dpmv8_debugtui_execute},
+		.read_debug = dpmv8_debugtui_read_timer_debug,
+	};
+	retval = armv8_debugtui_gic_transfer(&io, reg, result, uncertain);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = dpm->finish(dpm);
+	if (retval != ERROR_OK)
+		*uncertain = true;
+	return retval;
+}
