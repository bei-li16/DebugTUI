+	};
+	retval = armv8_debugtui_vfp_transfer(&io, request, result, uncertain);
+	if (retval != ERROR_OK)
+		return retval;
+	retval = dpm->finish(dpm);
+	if (retval != ERROR_OK)
+		*uncertain = true;
+	return retval;
+}
+
+int armv8_dpm_debugtui_vfp_write(struct arm_dpm *dpm,
+	const struct armv8_debugtui_vfp_write_request *request,
+	struct armv8_debugtui_vfp_write_result *result, bool *sent, bool *uncertain)
+{
+	*sent = false;
+	*uncertain = false;
+	int retval = dpmv8_debugtui_prepare(dpm);
+	if (retval != ERROR_OK) {
+		*uncertain = retval != ERROR_TARGET_NOT_HALTED;
+		return retval;
+	}
+	if (armv8_dpm_get_core_state(dpm) == ARM_STATE_AARCH64)
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	struct dpmv8_debugtui_context context = {
+		.dpm = dpm,
+		.execution_state = dpm->dscr & (DSCR_EL_STATUS_MASK | DSCR_CUR_EL | DSCR_NON_SECURE | DSCR_SDD),
+	};
+	struct armv8_debugtui_io io = {
+		.context = &context, .read_gpr = dpmv8_debugtui_read_gpr,
+		.write_gpr = dpmv8_debugtui_write_gpr, .execute = dpmv8_debugtui_execute,
+	};
+	retval = armv8_debugtui_vfp_write_transfer(&io, request, result, sent, uncertain);
+	if (retval != ERROR_OK && retval != DEBUGTUI_VFP_WRITE_MISMATCH)
+		return retval;
+	int finished = dpm->finish(dpm);
+	if (finished != ERROR_OK) {
+		*uncertain = true;
+		return finished;
+	}
+	return retval;
+}
+
+static int dpmv8_debugtui_read_timer_debug(void *context, uint32_t offset, uint32_t *value)
+{
+	struct dpmv8_debugtui_context *io = context;
+	struct armv8_common *armv8 = io->dpm->arm->arch_info;
+	uint32_t prsr;
+	int retval = mem_ap_read_atomic_u32(armv8->debug_ap,
+		armv8->debug_base + CPUV8_DBG_PRSR, &prsr);
+	if (retval != ERROR_OK)
+		return retval;
+	if (!(prsr & PRSR_HALT))
+		return ERROR_TARGET_NOT_HALTED;
+	retval = mem_ap_read_atomic_u32(armv8->debug_ap, armv8->debug_base + offset, value);
+	if (retval == ERROR_OK && offset == DEBUGTUI_TIMER_DSCR)
+		io->dpm->dscr = *value;
+	return retval;
+}
+
+int armv8_dpm_debugtui_timer(struct arm_dpm *dpm,
+	const struct armv8_debugtui_timer_register *reg,
