+	if (uncertain) {
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: Timer outcome unknown; reconnect required");
+		return retval == ERROR_OK ? ERROR_FAIL : retval;
+	}
+	if (retval > 0) {
+		const char *reason = retval == DEBUGTUI_TIMER_RESTRICTED ? "access-restricted" :
