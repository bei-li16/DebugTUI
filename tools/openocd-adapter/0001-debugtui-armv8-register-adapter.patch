+
+#define DEBUGTUI_VFP_PROTOCOL "debugtui-armv8-vfp-1 vmrs pair-readback dspsr no-enable stop-on-fault"
+#define DEBUGTUI_VFP_UNSUPPORTED 1
+#define DEBUGTUI_VFP_RESTRICTED 2
+#define DEBUGTUI_VFP_DISABLED 3
+#define DEBUGTUI_VFP_NOT_IMPLEMENTED 4
+#define DEBUGTUI_VMRS(reg) (UINT32_C(0xeef00a10) | ((reg) << 16))
+#define DEBUGTUI_READ_HCPTR ARMV4_5_MRC(15, 4, 0, 1, 1, 2)
+
+struct armv8_debugtui_vfp_request {
+	unsigned int control, pair, lane;
+	bool data, quad;
+};
+
+struct armv8_debugtui_vfp_result {
+	uint64_t words[2];
+	uint32_t mvfr0, mvfr1, fpexc, hcptr;
+	bool neon;
+};
+
+static inline bool armv8_debugtui_vfp_request(const char *name,
+	struct armv8_debugtui_vfp_request *request)
+{
+	memset(request, 0, sizeof(*request));
+	const struct { const char *name; unsigned int reg; } controls[] = {
+		{"fpsid", 0}, {"fpscr", 1}, {"mvfr0", 7}, {"mvfr1", 6}, {"mvfr2", 5}, {"fpexc", 8},
+	};
+	for (unsigned int i = 0; i < sizeof(controls) / sizeof(controls[0]); i++) {
+		if (!strcmp(name, controls[i].name)) {
+			request->control = controls[i].reg;
+			return true;
+		}
+	}
+	if (name[0] != 'd' && name[0] != 'q')
+		return false;
+	size_t length = strlen(name);
+	if (length != 2 && length != 3)
+		return false;
+	if (name[1] < '0' || name[1] > '9' || (length == 3 &&
+		(name[1] == '0' || name[2] < '0' || name[2] > '9')))
+		return false;
+	unsigned int index = name[1] - '0';
+	if (length == 3)
+		index = index * 10 + name[2] - '0';
+	request->quad = name[0] == 'q';
+	if (index >= (request->quad ? 16u : 32u))
+		return false;
+	request->data = true;
+	request->pair = request->quad ? index : index / 2;
+	request->lane = request->quad ? 0 : index % 2;
+	return true;
+}
+
+static inline int armv8_debugtui_vfp_features(uint32_t mvfr0, uint32_t mvfr1,
+	unsigned int *registers, bool *neon)
+{
+	unsigned int count = mvfr0 & 15, sp = (mvfr0 >> 4) & 15, dp = (mvfr0 >> 8) & 15;
+	uint32_t simd = mvfr1 & UINT32_C(0x000fff00);
+	/* R52 TRM 16.5/16.6 and DDI 0568 D1.3: D16 SP-only or D32 + NEON.
+	 * Unknown or contradictory encodings never authorize optional D/Q access. */
+	if (sp == 2 && count == 1 && dp == 0 && simd == 0) {
+		*registers = 16;
+		*neon = false;
+	} else if (sp == 2 && count == 2 && dp == 2 && simd == UINT32_C(0x00011100)) {
+		*registers = 32;
+		*neon = true;
+	} else {
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	}
+	return 0;
+}
+
+static inline int armv8_debugtui_vfp_transfer(const struct armv8_debugtui_io *io,
+	const struct armv8_debugtui_vfp_request *request,
+	struct armv8_debugtui_vfp_result *result, bool *uncertain)
+{
+	uint32_t before, after, midr, hcptr, mvfr0, mvfr1, fpexc;
+	struct armv8_debugtui_vfp_result sample = {0};
+	unsigned int registers = 0;
+	bool neon = false;
+	*uncertain = false;
+	int retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &before);
+	if (retval)
+		goto fault;
+	/* Hyp permits direct trap inspection. Other modes require another proven
+	 * reader/policy; do not inject inaccessible HCPTR or guess Guest permissions. */
+	if ((before & 31) != 0x1a)
+		return DEBUGTUI_VFP_RESTRICTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, ARMV4_5_MRC(15, 0, 0, 0, 0, 0), false, &midr);
+	if (retval)
+		goto fault;
+	if ((midr >> 24) != 0x41 || ((midr >> 4) & 0xfff) != 0xd13 || ((midr >> 16) & 15) != 15)
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_HCPTR, false, &hcptr);
+	if (retval)
+		goto fault;
+	if (hcptr & (1u << 10))
+		return DEBUGTUI_VFP_RESTRICTED; /* VMRS is also undefined in Hyp when TCP10=1. */
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(7), false, &mvfr0);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(6), false, &mvfr1);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_vfp_features(mvfr0, mvfr1, &registers, &neon);
+	if (retval && request->data)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(8), false, &fpexc);
+	if (retval)
+		goto fault;
+	if (request->data && (request->pair * 2 >= registers || (request->quad && !neon)))
+		return DEBUGTUI_VFP_NOT_IMPLEMENTED;
+	if ((request->data || request->control == 1) && !(fpexc & (1u << 30)))
+		return DEBUGTUI_VFP_DISABLED;
+	if (request->data) {
+		/* VMOV Rt,Rt2,Dn is permitted even by the SP-only instruction subset.
+		 * Read both D lanes once so all overlapping views share one raw sample.
+		 * VMOV is VFP, not an Advanced SIMD instruction; TASE is not bypassed
+		 * to execute NEON arithmetic. Q is only an implemented storage view. */
+		for (unsigned int i = 0; i < 2; i++) {
+			unsigned int index = request->pair * 2 + i;
+			retval = armv8_debugtui_mrrc_transfer(io, 11, 1 | ((index >> 4) << 1),
+				index & 15, &sample.words[i]);
+			if (retval)
+				goto fault;
+		}
+	} else {
+		uint32_t value;
+		if (request->control == 7)
+			value = mvfr0;
+		else if (request->control == 6)
+			value = mvfr1;
+		else if (request->control == 8)
+			value = fpexc;
+		else {
+			retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(request->control), false, &value);
+			if (retval)
+				goto fault;
+		}
+		sample.words[0] = value;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_VMRS(8), false, &after);
+	if (retval)
+		goto fault;
+	if (after != fpexc)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_HCPTR, false, &after);
+	if (retval)
+		goto fault;
+	if (after != hcptr)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval)
+		goto fault;
+	if (before != after)
+		goto mismatch;
+	sample.mvfr0 = mvfr0;
+	sample.mvfr1 = mvfr1;
+	sample.fpexc = fpexc;
+	sample.hcptr = hcptr;
+	sample.neon = neon;
+	*result = sample;
+	return 0;
+mismatch:
+	retval = -1;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
