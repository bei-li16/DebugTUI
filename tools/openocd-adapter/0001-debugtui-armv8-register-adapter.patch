+++ b/src/target/armv8_debugtui_r52.h
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_R52_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_R52_H
+
+#include "armv8_debugtui_timer.h"
+#include <stdio.h>
+
+#define DEBUGTUI_R52_PROTOCOL "debugtui-r52-core-1 external-identity current-el2 dspsr dlr fresh-capacity scratch-readback stop-on-fault"
+#define DEBUGTUI_R52_UNSUPPORTED 1
+#define DEBUGTUI_R52_RESTRICTED 2
+#define DEBUGTUI_R52_UNKNOWN 3
+#define DEBUGTUI_R52_NOT_IMPLEMENTED 4
+
+struct armv8_debugtui_r52_register {
+	const char *name;
+	unsigned int op1, crn, crm, op2;
+	int bank, region;
+};
+/* R52 TRM 100026_0104_01_en, reviewed sections recorded in the host
+ * catalogue. Only this release's identity/control/MPU subset is permitted. */
+static const struct armv8_debugtui_r52_register armv8_debugtui_r52_scalars[] = {
+	{"midr", 0, 0, 0, 0, -1, -1},
+	{"mpidr", 0, 0, 0, 5, -1, -1},
+	{"sctlr", 0, 1, 0, 0, -1, -1},
+	{"hsctlr", 4, 1, 0, 0, -1, -1},
+	{"cpacr", 0, 1, 0, 2, -1, -1},
+	{"hcr", 4, 1, 1, 0, -1, -1},
+	{"mpuir", 0, 0, 0, 4, -1, -1},
+	{"hmpuir", 4, 0, 0, 4, -1, -1},
+	{"prselr", 0, 6, 2, 1, 0, -1},
+	{"hprselr", 4, 6, 2, 1, 1, -1},
+	{"hprenr", 4, 6, 1, 1, 1, -1},
+	{"mair0", 0, 10, 2, 0, 0, -1},
+	{"mair1", 0, 10, 2, 1, 0, -1},
+	{"hmair0", 4, 10, 2, 0, 1, -1},
+	{"hmair1", 4, 10, 2, 1, 1, -1},
+};
+
+static inline bool armv8_debugtui_r52_find(const char *name,
+	struct armv8_debugtui_r52_register *reg)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_r52_scalars) /
+		sizeof(armv8_debugtui_r52_scalars[0]); i++) {
+		if (strcmp(name, armv8_debugtui_r52_scalars[i].name) == 0) {
+			*reg = armv8_debugtui_r52_scalars[i];
+			return true;
+		}
+	}
+	/* Tables 4-117/4-120/4-196/4-199: direct indexed PMSA encodings. */
+	for (unsigned int bank = 0; bank < 2; bank++) {
+		for (unsigned int index = 0; index < 24; index++) {
+			for (unsigned int limit = 0; limit < 2; limit++) {
+				char expected[16];
+				snprintf(expected, sizeof(expected), "%spr%car%u", bank ? "h" : "",
+					limit ? 'l' : 'b', index);
+				if (strcmp(name, expected) == 0) {
+					*reg = (struct armv8_debugtui_r52_register){.name = name,
+						.op1 = 4 * bank + index / 16, .crn = 6,
+						.crm = 8 + (index % 16) / 2, .op2 = 4 * (index % 2) + limit,
+						.bank = bank, .region = index};
+					return true;
+				}
+			}
+		}
+	}
+	return false;
+}
+
+struct armv8_debugtui_r52_result {
+	uint32_t midr, dscr, dspsr, dlr, capacity, value;
+};
+
+static inline const char *armv8_debugtui_r52_reason(int code)
+{
+	return code == DEBUGTUI_R52_RESTRICTED ? "debugtui-r52:access-restricted" :
+		code == DEBUGTUI_R52_UNKNOWN ? "debugtui-r52:access-unknown" :
+		code == DEBUGTUI_R52_NOT_IMPLEMENTED ? "debugtui-r52:not-implemented" :
+		"debugtui-r52:reader-unsupported";
+}
+
+static inline int armv8_debugtui_r52_transfer(const struct armv8_debugtui_timer_io *io,
+	const struct armv8_debugtui_r52_register *reg,
+	struct armv8_debugtui_r52_result *result, bool *uncertain)
+{
+	struct armv8_debugtui_r52_result sample = {0};
+	uint32_t after;
+	int denial = 0;
+	*uncertain = false;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &sample.dscr);
+	if (retval != 0)
+		goto fault;
+	if (sample.dscr & DEBUGTUI_TIMER_FAULT_MASK) {
+		retval = -1;
+		goto fault;
+	}
+	if (!armv8_debugtui_timer_state_valid(sample.dscr))
+		return (sample.dscr >> 8 & 3) == 2 && (sample.dscr & (1u << 15)) ?
+			DEBUGTUI_R52_RESTRICTED : DEBUGTUI_R52_UNSUPPORTED;
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &sample.midr);
+	if (retval != 0)
+		goto fault;
+	if ((sample.midr & UINT32_C(0xff0ffff0)) != UINT32_C(0x410fd130))
+		return DEBUGTUI_R52_UNSUPPORTED;
+	/* DDI 0568A.c: current EL2 has no higher EL trap target on v8-R.
+	 * HDD[15]=0 and the bounded instruction subset are required before any
+	 * CPU instruction. DSPSR describes stopped code, never authorization. */
+	if ((sample.dscr >> 8 & 3) != 2)
+		return reg->op1 >= 4 ? DEBUGTUI_R52_RESTRICTED : DEBUGTUI_R52_UNKNOWN;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &sample.dspsr);
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DLR, false, &sample.dlr);
+	if (retval != 0)
+		goto fault;
+	if (reg->bank >= 0) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, 4 * reg->bank, 0, 0, 0, 4), false, &sample.capacity);
+		if (retval != 0)
+			goto fault;
+		unsigned int count = reg->bank == 0 ? (sample.capacity >> 8 & 255) : (sample.capacity & 255);
+		if (count == 0 && reg->bank == 1)
+			denial = DEBUGTUI_R52_NOT_IMPLEMENTED;
+		else if (count != 16 && count != 20 && count != 24)
+			denial = DEBUGTUI_R52_UNSUPPORTED;
+		else if (reg->region >= 0 && (unsigned int)reg->region >= count)
+			denial = DEBUGTUI_R52_NOT_IMPLEMENTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	if (!denial) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, reg->op1, 0, reg->crn, reg->crm, reg->op2), false, &sample.value);
+		if (retval != 0)
+			goto fault;
+	}
+	if (reg->name && strcmp(reg->name, "midr") == 0 && sample.value != sample.midr) {
+		retval = -1;
+		goto fault;
+	}
+	if (reg->bank >= 0) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, 4 * reg->bank, 0, 0, 0, 4), false, &after);
+		if (retval != 0)
+			goto fault;
+		if (sample.capacity != after) {
+			retval = -1;
+			goto fault;
+		}
+	}
+	const uint32_t checks[] = {DEBUGTUI_READ_DSPSR, DEBUGTUI_READ_DLR};
+	const uint32_t expected[] = {sample.dspsr, sample.dlr};
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core, checks[i], false, &after);
+		if (retval != 0)
+			goto fault;
+		if (after != expected[i]) {
+			retval = -1;
+			goto fault;
+		}
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.midr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	if (denial)
+		return denial;
+	*result = sample;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+#endif
diff --git a/src/target/armv8_debugtui_timer.h b/src/target/armv8_debugtui_timer.h
new file mode 100644
index 0000000..c1f169b
--- /dev/null
+++ b/src/target/armv8_debugtui_timer.h
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_TIMER_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_TIMER_H
+
+#include "armv8_debugtui_banked.h"
+
+#define DEBUGTUI_TIMER_PROTOCOL "debugtui-armv8-timer-1 external-identity current-el dspsr dlr scratch-readback no-mode-change stop-on-fault"
+#define DEBUGTUI_TIMER_UNSUPPORTED 1
+#define DEBUGTUI_TIMER_RESTRICTED 2
+#define DEBUGTUI_TIMER_ACCESS_UNKNOWN 3
+#define DEBUGTUI_TIMER_DSCR UINT32_C(0x088)
+#define DEBUGTUI_TIMER_MIDR UINT32_C(0xd00)
+#define DEBUGTUI_TIMER_STATE_MASK UINT32_C(0x0005bf00)
+#define DEBUGTUI_TIMER_FAULT_MASK UINT32_C(0x1c0000c0)
+#define DEBUGTUI_READ_DLR ARMV4_5_MRC(15, 3, 0, 4, 5, 1)
+
+struct armv8_debugtui_timer_register {
+	const char *name;
+	unsigned int bits, op1, crm, op2, min_el;
+	bool physical;
+};
+
+/* R52 TRM 100026_0104_01, Table 11-1; DDI 0568A.c Table E1-1.
+ * "physical" requires CNTHCTL permission below EL2. CRn/CRm=14 is
+ * excluded from HSTR coarse traps (DDI 0568A.c H1-255). */
+static const struct armv8_debugtui_timer_register armv8_debugtui_timers[] = {
+	{"cntfrq", 32, 0, 0, 0, 0, false},
+	{"cntkctl", 32, 0, 1, 0, 1, false},
+	{"cntp_tval", 32, 0, 2, 0, 0, true},
+	{"cntp_ctl", 32, 0, 2, 1, 0, true},
+	{"cntv_tval", 32, 0, 3, 0, 0, false},
+	{"cntv_ctl", 32, 0, 3, 1, 0, false},
+	{"cnthctl", 32, 4, 1, 0, 2, false},
+	{"cnthp_tval", 32, 4, 2, 0, 2, false},
+	{"cnthp_ctl", 32, 4, 2, 1, 2, false},
+	{"cntpct", 64, 0, 14, 0, 0, true},
+	{"cntvct", 64, 1, 14, 0, 0, false},
+	{"cntp_cval", 64, 2, 14, 0, 0, true},
+	{"cntv_cval", 64, 3, 14, 0, 0, false},
+	{"cntvoff", 64, 4, 14, 0, 2, false},
+	{"cnthp_cval", 64, 6, 14, 0, 2, false},
+};
+
+struct armv8_debugtui_timer_io {
+	struct armv8_debugtui_io core;
+	/* External debug AP reads, never an injected CP15 identity/control read.
+ * The transport also verifies physical EDPRSR.HALT on every call. */
+	int (*read_debug)(void *context, uint32_t offset, uint32_t *value);
+};
+struct armv8_debugtui_timer_result {
+	uint32_t midr, dscr, dspsr, dlr;
+	uint64_t value;
+};
+
+static inline const struct armv8_debugtui_timer_register *armv8_debugtui_timer_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_timers) / sizeof(armv8_debugtui_timers[0]); i++)
+		if (strcmp(name, armv8_debugtui_timers[i].name) == 0)
+			return &armv8_debugtui_timers[i];
+	return NULL;
+}
+
+static inline bool armv8_debugtui_timer_state_valid(uint32_t dscr)
+{
+	unsigned int el = (dscr >> 8) & 3;
+	return el <= 2 && !(dscr & DEBUGTUI_TIMER_FAULT_MASK) && (dscr & (1u << 24)) &&
+		!(dscr & (1u << (10 + el))) && !(el == 2 && (dscr & (1u << 15)));
+}
+
+static inline int armv8_debugtui_timer_permission(const struct armv8_debugtui_timer_register *reg,
+	uint32_t dscr)
+{
+	unsigned int el = (dscr >> 8) & 3;
+	if (el < reg->min_el)
+		return DEBUGTUI_TIMER_RESTRICTED;
+	/* DDI 0487 M.b H2.4.5/8: system registers keep current EL permissions,
+ * including traps. HDD=0 does NOT bypass CNTHCTL or CNTKCTL. EL0's
+ * CNTKCTL and EL1's CNTHCTL cannot be read here without changing EL.
+ * Keep these enables unknown; never infer them from a cached CPSR/fact. */
+	if (el == 0 || (el == 1 && reg->physical))
+		return DEBUGTUI_TIMER_ACCESS_UNKNOWN;
+	return 0;
+}
+
+static inline int armv8_debugtui_timer_transfer(const struct armv8_debugtui_timer_io *io,
+	const struct armv8_debugtui_timer_register *reg,
+	struct armv8_debugtui_timer_result *result, bool *uncertain)
+{
+	struct armv8_debugtui_timer_result sample = {0};
+	uint32_t after, scalar = 0;
+	*uncertain = false;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &sample.dscr);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(sample.dscr)) {
+		if (sample.dscr & DEBUGTUI_TIMER_FAULT_MASK) {
+			retval = -1;
+			goto fault;
+		}
+		return DEBUGTUI_TIMER_UNSUPPORTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &sample.midr);
+	if (retval != 0)
+		goto fault;
+	if ((sample.midr >> 24) != 0x41 || ((sample.midr >> 16) & 15) != 15 ||
+		((sample.midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_TIMER_UNSUPPORTED;
+	retval = armv8_debugtui_timer_permission(reg, sample.dscr);
+	if (retval != 0)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &sample.dspsr);
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DLR, false, &sample.dlr);
+	if (retval != 0)
+		goto fault;
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	if (reg->bits == 64)
+		retval = armv8_debugtui_mrrc_transfer(&io->core, 15, reg->op1, reg->crm, &sample.value);
+	else {
+		retval = armv8_debugtui_mrc_mcr_transfer(&io->core,
+			ARMV4_5_MRC(15, reg->op1, 0, 14, reg->crm, reg->op2), false, &scalar);
+		sample.value = scalar;
+	}
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.dspsr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DLR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.dlr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_MIDR, &after);
+	if (retval != 0)
+		goto fault;
+	if (sample.midr != after) {
+		retval = -1;
+		goto fault;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_TIMER_DSCR, &after);
+	if (retval != 0)
+		goto fault;
+	if (!armv8_debugtui_timer_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_TIMER_STATE_MASK)) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_vfp.h b/src/target/armv8_debugtui_vfp.h
new file mode 100644
index 0000000..7472475
--- /dev/null
+++ b/src/target/armv8_debugtui_vfp.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_H
+
+#include "armv8_debugtui_banked.h"
+
+#define DEBUGTUI_VFP_PROTOCOL "debugtui-armv8-vfp-2 external-identity current-el dspsr dlr vmrs pair-readback no-enable stop-on-fault"
+#define DEBUGTUI_VFP_UNSUPPORTED 1
+#define DEBUGTUI_VFP_RESTRICTED 2
+#define DEBUGTUI_VFP_DISABLED 3
+#define DEBUGTUI_VFP_NOT_IMPLEMENTED 4
+#define DEBUGTUI_VMRS(reg) (UINT32_C(0xeef00a10) | ((reg) << 16))
+#define DEBUGTUI_READ_HCPTR ARMV4_5_MRC(15, 4, 0, 1, 1, 2)
+
+struct armv8_debugtui_vfp_request {
+	unsigned int control, pair, lane;
+	bool data, quad;
+};
+
+struct armv8_debugtui_vfp_result {
+	uint64_t words[2];
+	uint32_t mvfr0, mvfr1, fpexc, hcptr, dspsr, dlr, midr, dscr;
+	bool neon;
+};
+
+static inline bool armv8_debugtui_vfp_request(const char *name,
+	struct armv8_debugtui_vfp_request *request)
+{
+	memset(request, 0, sizeof(*request));
+	const struct { const char *name; unsigned int reg; } controls[] = {
+		{"fpsid", 0}, {"fpscr", 1}, {"mvfr0", 7}, {"mvfr1", 6}, {"mvfr2", 5}, {"fpexc", 8},
+	};
+	for (unsigned int i = 0; i < sizeof(controls) / sizeof(controls[0]); i++) {
+		if (!strcmp(name, controls[i].name)) {
+			request->control = controls[i].reg;
+			return true;
+		}
+	}
+	if (name[0] != 'd' && name[0] != 'q')
+		return false;
+	size_t length = strlen(name);
+	if (length != 2 && length != 3)
+		return false;
+	if (name[1] < '0' || name[1] > '9' || (length == 3 &&
+		(name[1] == '0' || name[2] < '0' || name[2] > '9')))
+		return false;
+	unsigned int index = name[1] - '0';
+	if (length == 3)
+		index = index * 10 + name[2] - '0';
+	request->quad = name[0] == 'q';
+	if (index >= (request->quad ? 16u : 32u))
+		return false;
+	request->data = true;
+	request->pair = request->quad ? index : index / 2;
+	request->lane = request->quad ? 0 : index % 2;
+	return true;
+}
+
+static inline int armv8_debugtui_vfp_features(uint32_t mvfr0, uint32_t mvfr1,
+	unsigned int *registers, bool *neon)
+{
+	unsigned int count = mvfr0 & 15, sp = (mvfr0 >> 4) & 15, dp = (mvfr0 >> 8) & 15;
+	uint32_t simd = mvfr1 & UINT32_C(0x000fff00);
+	/* R52 TRM 16.5/16.6 and DDI 0568 D1.3: D16 SP-only or D32 + NEON.
+	 * Unknown or contradictory encodings never authorize optional D/Q access. */
+	if (sp == 2 && count == 1 && dp == 0 && simd == 0) {
+		*registers = 16;
+		*neon = false;
+	} else if (sp == 2 && count == 2 && dp == 2 && simd == UINT32_C(0x00011100)) {
+		*registers = 32;
+		*neon = true;
+	} else {
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	}
+	return 0;
+}
+
+static inline int armv8_debugtui_vfp_transfer(const struct armv8_debugtui_banked_io *io,
+	const struct armv8_debugtui_vfp_request *request,
+	struct armv8_debugtui_vfp_result *result, bool *uncertain)
+{
+	uint32_t before, after, hcptr, mvfr0, mvfr1, fpexc;
+	struct armv8_debugtui_vfp_result sample = {0};
+	unsigned int registers = 0;
+	bool neon = false;
+	*uncertain = false;
+	int retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_DSCR, &sample.dscr);
+	if (retval)
+		goto fault;
+	if (!armv8_debugtui_banked_state_valid(sample.dscr)) {
+		if (sample.dscr & DEBUGTUI_BANKED_FAULT_MASK)
+			goto mismatch;
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	}
+	retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_MIDR, &sample.midr);
+	if (retval)
+		goto fault;
+	if ((sample.midr & UINT32_C(0xff0ffff0)) != UINT32_C(0x410fd130))
+		return DEBUGTUI_VFP_UNSUPPORTED;
+	/* Only fresh external EDSCR proves current Hyp. Saved DSPSR is not
+	 * current PSTATE; do not inject MIDR/HCPTR at an unproven lower EL.
+	 * EL1/Guest needs a separate proven permission reader, not a mode change. */
+	if (((sample.dscr >> 8) & 3) != 2)
+		return DEBUGTUI_VFP_RESTRICTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &before);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_BANKED_READ_DLR, false, &sample.dlr);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_HCPTR, false, &hcptr);
+	if (retval)
+		goto fault;
+	if (hcptr & (1u << 10))
+		return DEBUGTUI_VFP_RESTRICTED; /* VMRS is also undefined in Hyp when TCP10=1. */
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_VMRS(7), false, &mvfr0);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_VMRS(6), false, &mvfr1);
+	if (retval)
+		goto fault;
+	retval = armv8_debugtui_vfp_features(mvfr0, mvfr1, &registers, &neon);
+	if (retval && request->data)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_VMRS(8), false, &fpexc);
+	if (retval)
+		goto fault;
+	if (request->data && (request->pair * 2 >= registers || (request->quad && !neon)))
+		return DEBUGTUI_VFP_NOT_IMPLEMENTED;
+	if ((request->data || request->control == 1) && !(fpexc & (1u << 30)))
+		return DEBUGTUI_VFP_DISABLED;
+	retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_DSCR, &after);
+	if (retval)
+		goto fault;
+	if (!armv8_debugtui_banked_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_BANKED_STATE_MASK))
+		goto mismatch;
+	if (request->data) {
+		/* VMOV Rt,Rt2,Dn is permitted even by the SP-only instruction subset.
+		 * Read both D lanes once so all overlapping views share one raw sample.
+		 * VMOV is VFP, not an Advanced SIMD instruction; TASE is not bypassed
+		 * to execute NEON arithmetic. Q is only an implemented storage view. */
+		for (unsigned int i = 0; i < 2; i++) {
+			unsigned int index = request->pair * 2 + i;
+			retval = armv8_debugtui_mrrc_transfer(&io->core, 11, 1 | ((index >> 4) << 1),
+				index & 15, &sample.words[i]);
+			if (retval)
+				goto fault;
+		}
+	} else {
+		uint32_t value;
+		if (request->control == 7)
+			value = mvfr0;
+		else if (request->control == 6)
+			value = mvfr1;
+		else if (request->control == 8)
+			value = fpexc;
+		else {
+			retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_VMRS(request->control), false, &value);
+			if (retval)
+				goto fault;
+		}
+		sample.words[0] = value;
+	}
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_VMRS(8), false, &after);
+	if (retval)
+		goto fault;
+	if (after != fpexc)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_HCPTR, false, &after);
+	if (retval)
+		goto fault;
+	if (after != hcptr)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval)
+		goto fault;
+	if (before != after)
+		goto mismatch;
+	retval = armv8_debugtui_mrc_mcr_transfer(&io->core, DEBUGTUI_BANKED_READ_DLR, false, &after);
+	if (retval)
+		goto fault;
+	if (after != sample.dlr)
+		goto mismatch;
+	retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_MIDR, &after);
+	if (retval)
+		goto fault;
+	if (after != sample.midr)
+		goto mismatch;
+	retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_DSCR, &after);
+	if (retval)
+		goto fault;
+	if (!armv8_debugtui_banked_state_valid(after) ||
+		((sample.dscr ^ after) & DEBUGTUI_BANKED_STATE_MASK))
+		goto mismatch;
+	sample.mvfr0 = mvfr0;
+	sample.mvfr1 = mvfr1;
+	sample.fpexc = fpexc;
+	sample.hcptr = hcptr;
+	sample.dspsr = before;
+	sample.neon = neon;
+	*result = sample;
+	return 0;
+mismatch:
+	retval = -1;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_vfp_write.h b/src/target/armv8_debugtui_vfp_write.h
new file mode 100644
index 0000000..c833795
--- /dev/null
