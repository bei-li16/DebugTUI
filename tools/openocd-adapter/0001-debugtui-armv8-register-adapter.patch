+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_WRITE_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_VFP_WRITE_H
+
+#include "armv8_debugtui_vfp.h"
+
+#define DEBUGTUI_VFP_WRITE_PROTOCOL "debugtui-armv8-vfp-write-2 external-identity current-el dspsr dlr vmov raw-pair fresh-merge scratch-readback no-enable stop-on-fault"
+#define DEBUGTUI_VFP_WRITE_MISMATCH 5
+
+struct armv8_debugtui_vfp_write_request {
+	struct armv8_debugtui_vfp_request read;
+	unsigned int bits, shift;
+	uint64_t value[2];
+};
+
+struct armv8_debugtui_vfp_write_result {
+	struct armv8_debugtui_vfp_result before, observed;
+	uint64_t expected[2];
+};
+
+/* Only canonical fixed-width raw bits reach an instruction. No expression,
+ * floating-point conversion, control register, sign, whitespace or Tcl input. */
+static inline bool armv8_debugtui_vfp_write_request(const char *name, const char *raw,
+	struct armv8_debugtui_vfp_write_request *request)
+{
+	memset(request, 0, sizeof(*request));
+	if (name[0] == 's') {
+		char alias[4];
+		size_t length = strlen(name);
+		if ((length != 2 && length != 3) || name[1] < '0' || name[1] > '9' ||
+			(length == 3 && (name[1] == '0' || name[2] < '0' || name[2] > '9')))
+			return false;
+		unsigned int index = name[1] - '0';
+		if (length == 3)
+			index = index * 10 + name[2] - '0';
+		if (index >= 32)
+			return false;
+		unsigned int d = index / 2;
+		alias[0] = 'd';
+		alias[1] = '0' + (d >= 10 ? d / 10 : d);
+		alias[2] = d >= 10 ? '0' + d % 10 : '\0';
+		alias[3] = '\0';
+		if (!armv8_debugtui_vfp_request(alias, &request->read))
+			return false;
+		request->bits = 32;
+		request->shift = (index % 2) * 32;
+	} else {
+		if (!armv8_debugtui_vfp_request(name, &request->read) || !request->read.data)
+			return false;
+		request->bits = request->read.quad ? 128 : 64;
+	}
+	unsigned int digits = request->bits / 4;
+	if (strlen(raw) != digits + 2 || raw[0] != '0' || raw[1] != 'x')
+		return false;
+	for (unsigned int i = 0; i < digits; i++) {
+		char c = raw[i + 2];
+		unsigned int digit;
+		if (c >= '0' && c <= '9')
+			digit = c - '0';
+		else if (c >= 'a' && c <= 'f')
+			digit = c - 'a' + 10;
+		else if (c >= 'A' && c <= 'F')
+			digit = c - 'A' + 10;
+		else
+			return false;
+		unsigned int word = (digits - 1 - i) / 16;
+		request->value[word] = (request->value[word] << 4) | digit;
+	}
+	return true;
+}
+
+/* VMOV Dn,R0,R1 is a bit transfer permitted in the D16 SP-only subset.
+ * Save physical scratch registers and verify restoration before proceeding.
+ * A failing write/execute may have completed: stop, never retry or roll back. */
+static inline int armv8_debugtui_vfp_write_double(const struct armv8_debugtui_io *io,
+	unsigned int index, uint64_t value, bool *sent)
+{
+	uint32_t saved[2], restored;
+	int retval;
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &saved[i]);
+		if (retval)
+			return retval;
+	}
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, (uint32_t)(value >> ((i - 1) * 32)));
+		if (retval)
+			return retval;
+	}
+	*sent = true;
+	retval = io->execute(io->context, ARMV5_T_MCRR(11, 1 | ((index >> 4) << 1), 0, 1, index & 15));
+	if (retval)
+		return retval;
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, saved[i - 1]);
+		if (retval)
+			return retval;
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &restored);
+		if (retval)
+			return retval;
+		if (restored != saved[i])
+			return -1;
+	}
+	return 0;
+}
+
+static inline int armv8_debugtui_vfp_write_transfer(const struct armv8_debugtui_banked_io *io,
+	const struct armv8_debugtui_vfp_write_request *request,
+	struct armv8_debugtui_vfp_write_result *result, bool *sent, bool *uncertain)
+{
+	struct armv8_debugtui_vfp_write_result sample = {0};
+	*sent = false;
+	*uncertain = false;
+	int retval = armv8_debugtui_vfp_transfer(io, &request->read, &sample.before, uncertain);
+	if (retval)
+		return retval;
+	memcpy(sample.expected, sample.before.words, sizeof(sample.expected));
+	unsigned int lane = request->read.lane;
+	if (request->bits == 32) {
+		uint64_t mask = UINT64_C(0xffffffff) << request->shift;
+		sample.expected[lane] = (sample.expected[lane] & ~mask) | (request->value[0] << request->shift);
+	} else if (request->bits == 64) {
+		sample.expected[lane] = request->value[0];
+	} else {
+		memcpy(sample.expected, request->value, sizeof(sample.expected));
+	}
+	/* S/D write one D only. Q is explicitly two physical writes, not atomic. */
+	unsigned int count = request->bits == 128 ? 2 : 1;
+	for (unsigned int i = 0; i < count; i++) {
+		unsigned int selected = request->bits == 128 ? i : lane;
+		uint32_t state;
+		retval = io->read_debug(io->core.context, DEBUGTUI_BANKED_DSCR, &state);
+		if (retval)
+			goto fault;
+		if (!armv8_debugtui_banked_state_valid(state) ||
+			((state ^ sample.before.dscr) & DEBUGTUI_BANKED_STATE_MASK)) {
+			retval = -1;
+			goto fault;
+		}
+		retval = armv8_debugtui_vfp_write_double(&io->core, request->read.pair * 2 + selected,
+			sample.expected[selected], sent);
+		if (retval)
+			goto fault;
+	}
+	retval = armv8_debugtui_vfp_transfer(io, &request->read, &sample.observed, uncertain);
+	if (retval)
+		goto fault; /* Even a safe refusal now follows a possibly completed write. */
+	if (sample.before.midr != sample.observed.midr || sample.before.dlr != sample.observed.dlr ||
+		((sample.before.dscr ^ sample.observed.dscr) & DEBUGTUI_BANKED_STATE_MASK) ||
+		sample.before.dspsr != sample.observed.dspsr || sample.before.hcptr != sample.observed.hcptr ||
+		sample.before.fpexc != sample.observed.fpexc || sample.before.mvfr0 != sample.observed.mvfr0 ||
+		sample.before.mvfr1 != sample.observed.mvfr1) {
+		retval = -1;
+		goto fault;
+	}
+	*result = sample;
+	return memcmp(sample.expected, sample.observed.words, sizeof(sample.expected)) ?
+		DEBUGTUI_VFP_WRITE_MISMATCH : 0;
+fault:
+	*uncertain = true;
+	return retval < 0 ? retval : -1;
+}
+
+#endif
