+
+COMMAND_HANDLER(aarch64_debugtui_banked_command)
+{
+	if (CMD_ARGC != 1)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+	const struct armv8_debugtui_bank *bank = armv8_debugtui_bank_find(CMD_ARGV[0]);
+	if (!bank)
+		return ERROR_COMMAND_ARGUMENT_INVALID;
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target || !target_was_examined(target))
+		return ERROR_TARGET_NOT_EXAMINED;
+	struct arm *arm = target_to_arm(target);
+	if (!is_arm(arm) || !arm->arch_info || !is_armv8(arm->arch_info) || !arm->dpm)
+		return ERROR_TARGET_INVALID;
+	if (target->state != TARGET_HALTED)
+		return ERROR_TARGET_NOT_HALTED;
+	uint32_t value = 0;
+	bool uncertain = false;
+	int retval = armv8_dpm_debugtui_banked(arm->dpm, bank, &value, &uncertain);
+	if (uncertain) {
+		target->state = TARGET_UNKNOWN;
+		command_print(CMD, "Core state restoration failed: banked read outcome unknown; reconnect required");
+		return retval;
+	}
+	if (retval == DEBUGTUI_BANKED_UNSUPPORTED)
+		return ERROR_TARGET_INVALID;
+	if (retval == DEBUGTUI_BANKED_UNAVAILABLE)
+		return ERROR_TARGET_RESOURCE_NOT_AVAILABLE;
+	if (retval != ERROR_OK)
+		return retval;
+	command_print(CMD, "0x%08" PRIx32, value);
+	return ERROR_OK;
+}
