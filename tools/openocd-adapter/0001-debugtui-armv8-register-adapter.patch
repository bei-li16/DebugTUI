diff --git a/src/target/armv8_debugtui.h b/src/target/armv8_debugtui.h
new file mode 100644
index 0000000..9e0dde2
--- /dev/null
+++ b/src/target/armv8_debugtui.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "arm_opcodes.h"
+
+/* Transport-independent transaction, also compiled by the fault-injection test.
+ * A failed transfer stops immediately: exception state/transport completion is
+ * unknown, so neither a speculative rollback nor automatic retry is safe. */
+struct armv8_debugtui_io {
+	void *context;
+	int (*read_gpr)(void *context, unsigned int reg, uint32_t *value);
+	int (*write_gpr)(void *context, unsigned int reg, uint32_t value);
+	int (*execute)(void *context, uint32_t opcode);
+};
+
+static inline bool armv8_debugtui_mrrc_encoding_valid(unsigned int cp,
+	unsigned int op1, unsigned int crm)
+{
+	return cp <= 15 && op1 <= 15 && crm <= 15;
+}
+
+static inline int armv8_debugtui_mrc_mcr_transfer(const struct armv8_debugtui_io *io,
+	uint32_t opcode, bool write, uint32_t *value)
+{
+	uint32_t saved, result = 0, restored;
+	int retval = io->read_gpr(io->context, 0, &saved);
+	if (retval != 0)
+		return retval;
+	if (write) {
+		retval = io->write_gpr(io->context, 0, *value);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->execute(io->context, opcode);
+	if (retval != 0)
+		return retval;
+	if (!write) {
+		retval = io->read_gpr(io->context, 0, &result);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->write_gpr(io->context, 0, saved);
+	if (retval != 0)
+		return retval;
+	retval = io->read_gpr(io->context, 0, &restored);
+	if (retval != 0)
+		return retval;
+	if (restored != saved)
+		return -1;
+	if (!write)
+		*value = result;
+	return 0;
+}
+
+static inline int armv8_debugtui_mrrc_transfer(const struct armv8_debugtui_io *io,
+	unsigned int cp, unsigned int op1, unsigned int crm, uint64_t *value)
+{
+	uint32_t saved[2], result[2], restored[2];
+	int retval;
+
+	/* Read physical scratch values, including any changes from earlier debugger
+	 * commands. Do not substitute logical register-cache values. */
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &saved[i]);
+		if (retval != 0)
+			return retval;
+	}
+	retval = io->execute(io->context, ARMV5_T_MRRC(cp, op1, 0, 1, crm));
+	if (retval != 0)
+		return retval;
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &result[i]);
+		if (retval != 0)
+			return retval;
+	}
+	/* R0 is restored last, then both registers are physically read back. */
+	for (unsigned int i = 2; i > 0; i--) {
+		retval = io->write_gpr(io->context, i - 1, saved[i - 1]);
+		if (retval != 0)
+			return retval;
+	}
+	for (unsigned int i = 0; i < 2; i++) {
+		retval = io->read_gpr(io->context, i, &restored[i]);
+		if (retval != 0)
+			return retval;
+		if (restored[i] != saved[i])
+			return -1;
+	}
+	*value = ((uint64_t)result[1] << 32) | result[0];
+	return 0;
+}
+
+#endif
diff --git a/src/target/armv8_debugtui_banked.h b/src/target/armv8_debugtui_banked.h
new file mode 100644
index 0000000..f293869
--- /dev/null
+++ b/src/target/armv8_debugtui_banked.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef OPENOCD_TARGET_ARMV8_DEBUGTUI_BANKED_H
+#define OPENOCD_TARGET_ARMV8_DEBUGTUI_BANKED_H
+
+#include <string.h>
+#include "armv8_debugtui.h"
+
+#define DEBUGTUI_BANKED_PROTOCOL "debugtui-armv8-banked-1 mrs physical-readback no-mode-change stop-on-fault"
+#define DEBUGTUI_BANKED_UNSUPPORTED 1
+#define DEBUGTUI_BANKED_UNAVAILABLE 2
+#define DEBUGTUI_READ_DSPSR ARMV4_5_MRC(15, 3, 0, 4, 5, 0)
+#define DEBUGTUI_MRS_SPSR UINT32_C(0xf3ff8000)
+
+struct armv8_debugtui_bank {
+	const char *name;
+	unsigned int mode, gpr, sysm;
+	bool spsr;
+};
+
+/* DDI 0568A.c H1 BankedRegisterAccessValid/SPSRaccessValid. No Monitor
+ * mode exists on R52. Current banks use ordinary MOV/MRS, never an invalid
+ * banked MRS of the current bank. Hyp LR is the shared User LR, not ELR_hyp. */
+static const struct armv8_debugtui_bank armv8_debugtui_banks[] = {
+	{"r8_usr", 0x10, 8, 0, false}, {"r9_usr", 0x10, 9, 1, false},
+	{"r10_usr", 0x10, 10, 2, false}, {"r11_usr", 0x10, 11, 3, false},
+	{"r12_usr", 0x10, 12, 4, false}, {"sp_usr", 0x10, 13, 5, false},
+	{"lr_usr", 0x10, 14, 6, false},
+	{"r8_fiq", 0x11, 8, 8, false}, {"r9_fiq", 0x11, 9, 9, false},
+	{"r10_fiq", 0x11, 10, 10, false}, {"r11_fiq", 0x11, 11, 11, false},
+	{"r12_fiq", 0x11, 12, 12, false}, {"sp_fiq", 0x11, 13, 13, false},
+	{"lr_fiq", 0x11, 14, 14, false}, {"spsr_fiq", 0x11, 0, 14, true},
+	{"lr_irq", 0x12, 14, 16, false}, {"sp_irq", 0x12, 13, 17, false},
+	{"spsr_irq", 0x12, 0, 16, true},
+	{"lr_svc", 0x13, 14, 18, false}, {"sp_svc", 0x13, 13, 19, false},
+	{"spsr_svc", 0x13, 0, 18, true},
+	{"lr_abt", 0x17, 14, 20, false}, {"sp_abt", 0x17, 13, 21, false},
+	{"spsr_abt", 0x17, 0, 20, true},
+	{"lr_und", 0x1b, 14, 22, false}, {"sp_und", 0x1b, 13, 23, false},
+	{"spsr_und", 0x1b, 0, 22, true},
+	{"elr_hyp", 0x1a, 0, 30, false}, {"sp_hyp", 0x1a, 13, 31, false},
+	{"spsr_hyp", 0x1a, 0, 30, true},
+};
+
+static inline const struct armv8_debugtui_bank *armv8_debugtui_bank_find(const char *name)
+{
+	for (unsigned int i = 0; i < sizeof(armv8_debugtui_banks) / sizeof(armv8_debugtui_banks[0]); i++)
+		if (strcmp(armv8_debugtui_banks[i].name, name) == 0)
+			return &armv8_debugtui_banks[i];
+	return NULL;
+}
+
+static inline int armv8_debugtui_bank_opcode(const struct armv8_debugtui_bank *bank,
+	unsigned int mode, uint32_t *opcode)
+{
+	if (mode != 0x10 && mode != 0x11 && mode != 0x12 && mode != 0x13 &&
+		mode != 0x17 && mode != 0x1a && mode != 0x1b && mode != 0x1f)
+		return DEBUGTUI_BANKED_UNSUPPORTED;
+	bool current = bank->mode == mode || (bank->mode == 0x10 &&
+		((bank->gpr <= 12 && mode != 0x11) || mode == 0x1f ||
+		 (bank->gpr == 14 && mode == 0x1a)));
+	if (current && strcmp(bank->name, "elr_hyp") != 0) {
+		*opcode = bank->spsr ? DEBUGTUI_MRS_SPSR : UINT32_C(0xea4f0000) | bank->gpr;
+		return 0;
+	}
+	if (mode == 0x10 || (bank->mode == 0x1a && mode != 0x1a))
+		return DEBUGTUI_BANKED_UNAVAILABLE;
+	*opcode = UINT32_C(0xf3e08020) | ((bank->sysm & 15) << 16) |
+		((bank->sysm & 16) << 0) | (bank->spsr ? UINT32_C(0x00100000) : 0);
+	return 0;
+}
+
+static inline int armv8_debugtui_bank_transfer(const struct armv8_debugtui_io *io,
+	const struct armv8_debugtui_bank *bank, uint32_t *value, bool *uncertain)
+{
+	uint32_t before = 0, after = 0, midr = 0, opcode = 0, result = 0;
+	*uncertain = false;
+	/* DSPSR is accessible at every EL in Debug state and contains the entire
+	 * stopped CPSR. Ordinary MRS CPSR masks execution bits and cannot safely
+	 * determine User mode. R52 TRM c4, op1=3,c5,op2=0. */
+	int retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &before);
+	if (retval != 0)
+		goto fault;
+	/* No privileged MIDR or banked MRS is attempted from User mode. Its
+	 * current registers remain available through the ordinary Core view. */
+	if ((before & 31) == 0x10)
+		return DEBUGTUI_BANKED_UNAVAILABLE;
+	retval = armv8_debugtui_bank_opcode(bank, before & 31, &opcode);
+	if (retval != 0)
+		return retval;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, ARMV4_5_MRC(15, 0, 0, 0, 0, 0), false, &midr);
+	if (retval != 0)
+		goto fault;
+	if ((midr >> 24) != 0x41 || ((midr >> 4) & 0xfff) != 0xd13)
+		return DEBUGTUI_BANKED_UNSUPPORTED;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, opcode, false, &result);
+	if (retval != 0)
+		goto fault;
+	retval = armv8_debugtui_mrc_mcr_transfer(io, DEBUGTUI_READ_DSPSR, false, &after);
+	if (retval != 0)
+		goto fault;
+	if (before != after) {
+		retval = -1;
+		goto fault;
+	}
+	*value = result;
+	return 0;
+fault:
+	*uncertain = true;
+	return retval;
+}
+
+#endif
