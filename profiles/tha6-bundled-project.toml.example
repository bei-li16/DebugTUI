# Copy to the THA MCAL project root as debug.toml.
# GDB, OpenOCD, chip configuration and SVD come from the DebugTUI package.
# Build and flash still use this MCAL project's compiler/scripts/vendor flasher.
version = 3
watch = ["uart_cnt"]
[tools]
profile = "builtin:arm-openocd"
probe = "cmsis-dap"
[debug]
chip = "tha6206"
cores = [0, 1]
[program]
elf = "DemoWorkspace/CodeProject/Debug/${chip_upper}_Demo_Prj.elf"
source_root = "."
[tasks]
build = '.\DemoWorkspace\CodeProject\Build.bat ghs rebuild ${chip}'
download = '.\.vscode\Load.bat ${chip}'
[session]
on_exit = "detach"
log_dir = "debug_log"
[multicore]
scope = "all"
halt_peers = true
restart_core = "core.0"
restart = ["monitor chipreset", "monitor foreach _core {${unselected_core_ids}} {targets core.$_core; resume}; targets core.0", "maintenance flush register-cache"]
[live_watch]
bus_target = "AHB_3"
elf = "DemoWorkspace/CodeProject/Debug/${chip_upper}_Demo_Prj.elf"
interval_ms = 200
tcl_endpoint = "127.0.0.1:6666"

# Selected helper sessions attach first, core0 resets once, then only unselected
# helpers resume. core1-only is an attach: core0 must already have initialized it.
[[cores]]
name = "core.0"
startup_order = 3
after_connect = ["monitor chipreset", "monitor foreach _core {${unselected_core_ids}} {targets core.$_core; resume}; targets core.0", "maintenance flush register-cache"]
run = ["tbreak _main", "-exec-continue"]
[[cores]]
name = "core.1"
startup_order = 0
after_connect = ["monitor halt", "maintenance flush register-cache"]
run = ["-exec-continue"]
[[cores]]
name = "core.2"
startup_order = 1
after_connect = ["monitor halt", "maintenance flush register-cache"]
run = ["-exec-continue"]
[[cores]]
name = "core.3"
startup_order = 2
after_connect = ["monitor halt", "maintenance flush register-cache"]
run = ["-exec-continue"]
