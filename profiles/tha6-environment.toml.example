# Copy into the MCAL project's .vscode directory as debug-env-chip.toml.
backend = "tha6"
[gdb]
executable = "./gdb/arm-none-eabi-gdb.exe"
args = ["-x", "${profile_dir}/gdb.cfg"]
init = ["maintenance set dwarf unwind off", "set remotetimeout 10"]
registers = ["r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10", "r11", "r12", "sp", "lr", "pc", "cpsr"]
# Optional project-level system register settings: docs/registers-readonly-guide.md.
# Use [registers], independently of the gdb.registers name list above:
# cpu="cortex-r52", tcl_endpoint="127.0.0.1:6666".
# The pinned modified adapter's bounded R52 readonly path uses the matching
# cp15_command="aarch64 r52_read", selector_command="aarch64 r52_select",
# isb_command="". Fresh current Debug EL2 proof is required, not saved CPSR.
# This MPU selector protocol does not cover PMU; stock xPack is not equivalent.
# Legacy cp15_command="arm mrc" / selector_command="arm mcr" is a separate
# compatibility path requiring verified backend support and its own restrictions.
# For the separately built pinned adapter, opt in with
# banked_command="aarch64 banked"; stock xPack does not provide this protocol.
# Banked access requires the stopped physical frame 0 and actual R52 MIDR.
# vfp_command="aarch64 vfp" opts into the independent VFP protocol.
# timer_command="aarch64 timer" selects the independent checked Timer protocol.
# Timer permission uses fresh physical Debug EL evidence; stock xPack lacks it.
# vfp_write_command="aarch64 vfp_write" independently enables raw S/D/Q drafts.
# A reader or RW label alone never enables editing; stock xPack lacks this writer.
# VFP data requires verified Hyp permissions and FPEXC.EN; never enabled here.
# declare [registers.targets] with the physical target name for each core.
# These are examples, not a verified THA6 OpenOCD target/command mapping.
[service]
enabled = true
command = "./openocd/bin/openocd.exe"
# MCAL bootstrap may need unselected helper cores, so examine all supported cores.
# For a board that needs only selected cores, use ${core_mask} instead.
args = ["-c", "set CHIPNAME ${chip}", "-c", "set DEBUGCORE ${available_core_mask}", "-f", "${profile_dir}/openocd.cfg"]
cwd = "."
timeout_ms = 20000
[target]
mode = "extended-remote"
after_connect = []
[actions]
run = ["-exec-continue"]
restart = []
[multicore]
restart = ["monitor chipreset", "monitor foreach _core {${unselected_core_ids}} {targets core.$_core; resume}; targets core.0"]
[session]
timeout_ms = 8000
[core_targets."0"]
endpoint = "127.0.0.1:3333"
ready = "Listening on port 3333 for gdb connections"
[core_targets."1"]
endpoint = "127.0.0.1:3334"
ready = "Listening on port 3334 for gdb connections"
[core_targets."2"]
endpoint = "127.0.0.1:3335"
ready = "Listening on port 3335 for gdb connections"
[core_targets."3"]
endpoint = "127.0.0.1:3336"
ready = "Listening on port 3336 for gdb connections"

# registers.pmu_command="aarch64 pmu" explicitly opts in to the independent read-only PMU protocol.
# Current Debug EL2, fresh PMCR.N and identity are checked; lower-EL traps remain Unknown.
# Indexed event reads preserve PMSELR; observation never enables/resets counters.

# STM is a chip component, not implied by an R52 CPU. Map its verified control
# aperture in the project via registers.component_owners.stm."chip:<id>".
# Optional stm_hwe/stm_dma need explicit mappings to the same aperture/route.
# See docs/register-stm.md; no base/AP or stimulus address is guessed here.
