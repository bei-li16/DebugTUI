<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.3">
  <name>TestDevice</name><version>1</version><description>Register reader fixture</description>
  <cpu><name>CM4</name><revision>r0p0</revision><endian>little</endian><mpuPresent>false</mpuPresent><fpuPresent>false</fpuPresent><nvicPrioBits>4</nvicPrioBits><vendorSystickConfig>false</vendorSystickConfig></cpu>
  <addressUnitBits>8</addressUnitBits><width>32</width><size>32</size><access>read-write</access>
  <peripherals>
    <peripheral><name>PORT</name><description>Test port</description><baseAddress>0x40000000</baseAddress>
      <registers>
        <register><name>DATA</name><description>Data</description><addressOffset>0</addressOffset>
          <fields><field><name>LOW</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field></fields>
        </register>
        <register><name>WO</name><addressOffset>4</addressOffset><access>write-only</access></register>
        <register><name>CLEAR</name><addressOffset>8</addressOffset><readAction>clear</readAction></register>
        <register><name>FIELD_CLEAR</name><addressOffset>12</addressOffset>
          <fields><field><name>FLAG</name><bitRange>[0:0]</bitRange><readAction>clear</readAction></field></fields>
        </register>
        <cluster><dim>2</dim><dimIncrement>16</dimIncrement><name>CH%s</name><addressOffset>32</addressOffset>
          <register><dim>2</dim><dimIncrement>4</dimIncrement><name>VALUE%s</name><addressOffset>0</addressOffset><size>16</size></register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="PORT"><name>PORT2</name><baseAddress>0x40001000</baseAddress></peripheral>
  </peripherals>
</device>
