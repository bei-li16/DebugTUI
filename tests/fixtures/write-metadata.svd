<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.3">
  <name>WriteFixture</name><version>1</version><description>Software-only permissions fixture</description>
  <addressUnitBits>8</addressUnitBits><width>32</width><size>8</size><access>read-write</access>
  <peripherals><peripheral><name>PORT</name><baseAddress>0x40000000</baseAddress><registers>
    <register><name>MIXED</name><addressOffset>0</addressOffset><modifiedWriteValues>oneToClear</modifiedWriteValues>
      <writeConstraint><range><minimum>1</minimum><maximum>3</maximum></range></writeConstraint>
      <fields>
        <field><name>RW</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth><modifiedWriteValues>modify</modifiedWriteValues><writeConstraint><useEnumeratedValues>true</useEnumeratedValues></writeConstraint>
          <enumeratedValues><usage>read</usage><enumeratedValue><name>ReadOnlyName</name><value>2</value></enumeratedValue></enumeratedValues>
          <enumeratedValues><usage>write</usage><enumeratedValue><name>Off</name><value>0</value></enumeratedValue><enumeratedValue><name>On</name><value>1</value></enumeratedValue></enumeratedValues>
        </field>
        <field><name>FLAG</name><bitOffset>2</bitOffset><bitWidth>2</bitWidth></field>
        <field><name>RO</name><bitOffset>4</bitOffset><bitWidth>2</bitWidth><access>read-only</access></field>
        <field><name>KEEP</name><bitOffset>6</bitOffset><bitWidth>2</bitWidth><modifiedWriteValues>modify</modifiedWriteValues><writeConstraint><writeAsRead>true</writeAsRead></writeConstraint></field>
      </fields>
    </register>
    <register derivedFrom="MIXED"><name>DERIVED</name><addressOffset>4</addressOffset></register>
    <register><name>WO</name><addressOffset>8</addressOffset><access>write-only</access></register>
    <register><name>READ_CLEAR</name><addressOffset>12</addressOffset><fields><field><name>FLAG</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth><readAction>clear</readAction></field></fields></register>
  </registers></peripheral></peripherals>
</device>
